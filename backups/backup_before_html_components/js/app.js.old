  }
}
window.deleteGcpPoint = function (arg1) {
  if (!state.flightEngine || !state.flightEngine.gcpPoints) {
    return;
  }
  const v_2 = state.flightEngine.gcpPoints.find(item => item.id == arg1 || item.name == arg1);
