      iconColor: "text-purple",
      pdfUrl: "https://www.harita.gov.tr/urun/turkiye-hibrit-jeoidi-2020-tg-20/66",
      portalUrl: "https://www.harita.gov.tr/urun/turkiye-hibrit-jeoidi-2020-tg-20/66"
    },
    "hgm-turef": {
