      labelEl.innerHTML = "<input type=\"checkbox\" class=\"chk-dynamic-band\" data-band=\"" + item + "\" checked style=\"accent-color: " + v_1.color + ";\" /> <span>" + v_1.label + "</span>";
      domEl_1.appendChild(labelEl);
    });
  }
  if (domEl_2) {
