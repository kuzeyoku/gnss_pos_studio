    const v_1_1 = state.paftaEngine.getVisibleSheets(v_2, v_3, v_4, v_5, "100k");
    v_1_1.forEach(item => {
      L.rectangle([[item.minLat, item.minLon], [item.maxLat, item.maxLon]], {
        color: "#10b981",
        weight: 1,
