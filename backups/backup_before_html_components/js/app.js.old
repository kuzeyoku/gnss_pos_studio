      const btnEl_4 = document.getElementById("txtRoadBtn");
      if (btnEl_4) {
        btnEl_4.textContent = "İndiriliyor...";
      }
      if (btnEl_3) {
        btnEl_3.disabled = true;
      }
      logMessage("🛣️ [YOL SORGUSU] OpenStreetMap sunucularından yol ağı indiriliyor...");
