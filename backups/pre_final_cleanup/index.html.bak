                </button>
                <button class="btn btn-secondary btn-outline-emerald btn-sm text-xs" id="btnExportBatchKml">
                  <i class="fa-solid fa-globe text-emerald"></i> Google Earth (.kml)
                </button>
                <button class="btn btn-secondary btn-outline-amber btn-sm text-xs" id="btnExportBatchTxt">
                  <i class="fa-solid fa-file-lines text-amber"></i> Metin / CSV (.txt)
                </button>
                <button class="btn btn-secondary btn-outline-emerald btn-sm text-xs" id="btnCopyBatchTg20"
                  title="NoktaNo Enlem Boylam Kot formatında panoya kopyala">
                  <i class="fa-solid fa-clipboard-check"></i> TG-20 Kopyala
                </button>
                <button class="btn btn-secondary btn-soft-emerald btn-sm text-xs" id="btnSendBatchToTg20"
                  title="Doğrudan TG-20 sekmesine aktar ve hesapla">
                  <i class="fa-solid fa-mountain-sun"></i> TG-20'ye Gönder ➔
                </button>
              </div>
            </div>

            <div class="table-container table-scroll-350 w-100">
              <table class="table-hover w-100">
                <thead>
                  <tr>
                    <th class="th-w-40px">#</th>
                    <th data-i18n="ui.noktaAdi"></th>
                    <th id="thBatchSrc1">Kaynak 1</th>
                    <th id="thBatchSrc2">Kaynak 2</th>
                    <th data-i18n="ui.kaynakKot"></th>
                    <th id="thBatchTgt1" class="text-cyan" data-i18n="ui.donusen1"></th>
                    <th id="thBatchTgt2" class="text-cyan" data-i18n="ui.donusen2"></th>
                    <th class="text-cyan" data-i18n="ui.donusenKot"></th>
