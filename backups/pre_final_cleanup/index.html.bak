        <!-- ================= CARD 3: LOCAL 2D HELMERT TRANSFORMATION ================= -->
        <div class="card d-flex flex-col gap-14">
          <div class="card-header mb-0 pb-4">
            <div class="card-title">
              <i class="fa-solid fa-shapes text-amber"></i>
              <span data-i18n="ui.3Lokal2bHelmert"></span>
            </div>
            <div class="d-flex gap-4">
              <button type="button" class="btn btn-primary btn-sm text-xs py-3 px-8" id="btnTabHelmertDns" data-i18n="ui.netcadDnsDosyasi"></button>
              <button type="button" class="btn btn-secondary btn-sm text-xs py-3 px-8" id="btnTabHelmertPoints">📌 Ortak
                Noktalardan</button>
            </div>
          </div>

          <div class="text-xs text-muted">
            Bölgesel Netcad <code>.DNS</code> parametre dosyanızı yükleyin veya ortak kontrol noktalarından dönüşüm
            matrisi hesaplayarak noktalarınızı anında dönüştürün.
          </div>

          <!-- Geodetic Rule: 3-Degree Zone Requirement Alert -->
          <div class="alert-helmert-notice">
            <i class="fa-solid fa-circle-info text-amber text-lg flex-shrink-0 mt-2"></i>
            <div>
              <strong class="text-amber d-block mb-2 text-xs font-bold uppercase" data-i18n="ui.onemliJeodezikKural3"></strong>
              <span class="text-xs">Dönüşüm parametreleri (Helmert 2D ve Netcad <code>.DNS</code>) <strong data-i18n="ui.yalnizca3LikTransverse"></strong> uygulanabilir (6° UTM projeksiyonlarında
                distorsiyon ve ölçek farkından dolayı 2D lokal benzerlik dönüşümü yapılamaz). Eğer noktalarınız 6° UTM
                formatında ise, lütfen önce yukarıdaki <strong data-i18n="ui.2TopluListeDosya"></strong> aracını
                kullanarak verilerinizi ilgili 3° dilime çevirin, ardından burada Helmert dönüşümünü uygulayın.</span>
            </div>
          </div>

          <!-- 2-Column Main Workspace -->
          <div class="grid-2col-helmert">
            <!-- Left: Parameter Input Modes (DNS File vs Common Points) -->
            <div class="geodesy-panel-box d-flex flex-col gap-10">
              <div class="d-flex justify-between items-center">
                <span class="text-sm font-bold text-cyan uppercase" data-i18n="ui.1DonusumParametreKaynagi"></span>
              </div>

              <!-- Pane A: Netcad .DNS File Loader -->
              <div id="paneHelmertDns" class="d-flex flex-col gap-8">
                <div class="file-upload-glass p-10 text-center">
                  <span id="txtHelmertDnsFileName" class="text-sm text-main d-flex items-center justify-center gap-6">
                    <i class="fa-solid fa-file-lines text-cyan"></i> <span data-i18n="ui.netcadDnsParametreDosyasi"></span>
                  </span>
                  <input type="file" id="inputHelmertDnsFile" accept=".dns,.txt" />
                </div>
                <div class="text-xs text-dim" data-i18n="ui.veyaDnsDosyaIcerigini"></div>
                <textarea id="txtHelmertDnsContent" rows="4"
                  placeholder="[NETCAD_DONUSUM]&#10;TIP=HELMERT2D&#10;A=0.99995377&#10;B=-0.00004665&#10;DY=236.5729&#10;DX=189.7714"
                  class="dns-textarea"></textarea>
                <button class="btn btn-primary w-full py-8 px-12 text-sm font-bold" id="btnApplyDnsParams">
                  <i class="fa-solid fa-check"></i> DNS Parametrelerini Yükle & Aktif Et
                </button>
              </div>

              <!-- Pane B: Common Control Points Calculator -->
              <div id="paneHelmertPoints" class="d-none flex-col gap-8">
                <div class="d-flex justify-between items-center">
                  <span class="text-xs text-dim font-mono">
                    Format: NoktaNo Y_Kaynak X_Kaynak Y_Hedef X_Hedef
                  </span>
                  <button type="button" class="btn btn-secondary btn-sm text-xs py-2 px-6" id="btnLoadHelmertSample">
                    <i class="fa-solid fa-flask"></i> Örnek Yükle
                  </button>
                </div>
                <textarea id="txtHelmertCommonPoints" rows="5"
                  placeholder="P1  500120.000  4520100.000  500122.500  4520104.200&#10;P2  501240.000  4520150.000  501242.600  4520154.100&#10;P3  501260.000  4521200.000  501262.400  4521204.300&#10;P4  500150.000  4521180.000  500152.700  4521184.000"
                  class="dns-textarea"></textarea>
                <button class="btn btn-primary w-full py-8 px-12 text-sm font-bold" id="btnSolveHelmert">
                  <i class="fa-solid fa-calculator"></i> Ortak Noktalardan Parametreleri Hesapla
                </button>
              </div>
            </div>

            <!-- Right: Points to Transform -->
            <div class="geodesy-panel-box d-flex flex-col gap-10">
              <label class="text-sm font-bold text-emerald uppercase m-0" data-i18n="ui.2DonusturulecekNoktalarHedef"></label>
              <div class="text-xs text-dim font-mono" data-i18n="ui.formatNoktanoYKaynak"></div>
              <textarea id="txtHelmertPointsToTransform" rows="6"
                placeholder="101  500500.000  4520500.000  125.400&#10;102  500650.000  4520750.000  128.200&#10;103  500800.000  4520900.000  131.050&#10;104  500950.000  4521050.000  133.800"
                class="dns-textarea min-h-120"></textarea>

              <button class="btn btn-primary w-full py-10 px-14 text-sm font-bold" id="btnTransformHelmertPoints">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Noktaları Yeni Sisteme Dönüştür
              </button>
            </div>
          </div>

          <!-- Helmert Solution Results Dashboard -->
          <div id="helmertResultsWrapper" class="helmert-results-container d-none mt-14 flex-col gap-12">
            <!-- Parameter Stat Cards -->
            <div class="helmert-solution-card p-14 rounded-sm">
              <div class="helmert-card-header-flex">
                <div class="d-flex items-center gap-8">
                  <i class="fa-solid fa-circle-check text-emerald"></i>
                  <strong id="lblHelmertStatusSource" class="font-bold text-main helmert-status-title" data-i18n="ui.aktifHelmert2dParametreleri"></strong>
                  <span id="badgeHelmertM0" class="badge badge-helmert-m0">m0 = 0.00 cm</span>
                </div>
              </div>

              <div class="helmert-params-auto-grid">
                <div class="helmert-param-box">
                  <span class="helmert-param-label">a Parametresi:</span>
                  <strong id="resHelmertA" class="text-sky">1.00000000</strong>
                </div>
                <div class="helmert-param-box">
                  <span class="helmert-param-label">b Parametresi:</span>
                  <strong id="resHelmertB" class="text-sky">0.00000000</strong>
                </div>
                <div class="helmert-param-box">
                  <span class="helmert-param-label" data-i18n="ui.yOteleme"></span>
                  <strong id="resHelmertDy" class="text-amber">0.000 m</strong>
                </div>
                <div class="helmert-param-box">
                  <span class="helmert-param-label" data-i18n="ui.xOteleme"></span>
                  <strong id="resHelmertDx" class="text-amber">0.000 m</strong>
                </div>
                <div class="helmert-param-box">
                  <span class="helmert-param-label" data-i18n="ui.olcekKatsayisiM"></span>
                  <strong id="resHelmertScale" class="text-emerald">1.00000000</strong>
                </div>
                <div class="helmert-param-box">
                  <span class="helmert-param-label" data-i18n="ui.donukluk"></span>
                  <strong id="resHelmertTheta" class="helmert-param-val-purple">0.000000 grad</strong>
                </div>
              </div>
            </div>

            <!-- Residuals & Control Points Table (if solved from points) -->
            <div id="wrapperHelmertResiduals">
              <h5 class="helmert-section-title-cyan">
                <i class="fa-solid fa-list-check"></i> Ortak Noktalar Dengeleme Hata Dağılımı (Kalıntılar):
              </h5>
              <div class="table-container table-h180">
                <table>
                  <thead>
                    <tr>
                      <th data-i18n="converter.kpiPoints"></th>
                      <th>Y (Kaynak)</th>
                      <th>X (Kaynak)</th>
                      <th>Y (Hedef)</th>
                      <th>X (Hedef)</th>
                      <th class="helmert-th-vy">vY (cm)</th>
                      <th class="helmert-th-vx">vX (cm)</th>
                      <th class="helmert-th-vs">vS (cm)</th>
                    </tr>
                  </thead>
                  <tbody id="tbodyHelmertResiduals"></tbody>
                </table>
              </div>
            </div>

            <!-- Transformed Points Result Table -->
            <div>
              <div class="helmert-export-row">
                <h5 class="helmert-section-title-emerald">
                  <i class="fa-solid fa-circle-check"></i> Yeni Sisteme Dönüştürülen Noktalar:
                </h5>
                <div class="helmert-export-btns">
                  <button type="button" class="btn btn-secondary btn-sm helmert-btn-sm" id="btnExportHelmertNcn">
                    <i class="fa-solid fa-file-export text-cyan"></i> Netcad .NCN
                  </button>
                  <button type="button" class="btn btn-secondary btn-sm helmert-btn-sm" id="btnExportHelmertDxf">
                    <i class="fa-solid fa-file-lines text-purple"></i> AutoCAD .DXF
                  </button>
                  <button type="button" class="btn btn-secondary btn-sm helmert-btn-sm" id="btnExportHelmertCsv">
                    <i class="fa-solid fa-table text-emerald"></i> CSV / Metin
                  </button>
                </div>
              </div>
              <div class="table-container table-h220">
                <table>
                  <thead>
                    <tr>
                      <th>#</th>
                      <th data-i18n="cadastre.btnLabels"></th>
                      <th>Y (Kaynak)</th>
                      <th>X (Kaynak)</th>
                      <th class="helmert-th-result" data-i18n="ui.yDonusen"></th>
                      <th class="helmert-th-result" data-i18n="ui.xDonusen"></th>
                      <th data-i18n="ui.kotZ"></th>
                    </tr>
                  </thead>
                  <tbody id="tbodyHelmertTransformed"></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

      </section>

      <!-- ================= TAB: TG-20 GEOID & HEIGHT REDUCTION STUDIO ================= -->
      <section id="tab-tg20" class="tool-tab">

        <!-- Top Segmented Sub-Tab Switcher -->
        <div class="tg20-subtab-nav">
          <button type="button" class="tg20-subtab-btn active" id="btnTg20SubtabCalc" data-tg20-target="tg20PaneCalc">
            <i class="fa-solid fa-calculator text-cyan"></i>
            <span data-i18n="tg20.tabReductionTools"></span>
            <span class="badge badge-cyan text-2xs" data-i18n="tg20.tabReductionToolsSub"></span>
          </button>
          <button type="button" class="tg20-subtab-btn" id="btnTg20SubtabMap" data-tg20-target="tg20PaneMap">
            <i class="fa-solid fa-map-location-dot text-amber"></i>
            <span data-i18n="tg20.tabInteractiveMap"></span>
            <span class="badge badge-amber text-2xs" data-i18n="tg20.tabInteractiveMapSub"></span>
          </button>
        </div>

        <!-- ================= SUB-TAB PANE 1: CALCULATION TOOLS (SINGLE & BATCH) ================= -->
        <div id="tg20PaneCalc" class="tg20-pane active">

          <!-- Bento Grid: Top Row (Single Point + Info/Regions) -->
          <div class="tg20-top-grid">

            <!-- Card 1: Tek Nokta WGS-84 İndirgeme -->
            <div class="card d-flex flex-col gap-12">
              <div class="card-header mb-0">
                <div class="card-title">
                  <i class="fa-solid fa-location-crosshairs text-cyan"></i>
                  <span data-i18n="tg20.singleReductionCardTitle"></span>
                </div>
                <div class="d-flex gap-6">
                  <span class="badge badge-emerald text-xs" data-i18n="tg20.badgeHgmOfficial"></span>
                </div>
              </div>

              <div class="tg20-coord-inputs-grid">
                <div>
                  <label class="text-xs font-semibold text-dim d-block mb-4" data-i18n="tg20.lblLatWgs84"></label>
                  <input type="text" id="inputTg20Lat" value="39.920800" placeholder="39.920800 veya 39 55 14.88"
                    class="geo-coord-input" />
                </div>
                <div>
                  <label class="text-xs font-semibold text-dim d-block mb-4" data-i18n="tg20.lblLonWgs84"></label>
                  <input type="text" id="inputTg20Lon" value="32.854100" placeholder="32.854100 veya 32 51 14.76"
                    class="geo-coord-input" />
                </div>
                <div>
                  <label class="text-xs font-semibold text-cyan d-block mb-4" data-i18n="tg20.lblHgtWgs84"></label>
                  <input type="number" id="inputTg20H" value="900.000" step="0.001" placeholder="900.000"
                    class="geo-coord-input border-cyan" />
                </div>
              </div>

              <div class="d-flex justify-between items-center flex-wrap gap-8">
                <button type="button" class="btn btn-primary text-xs py-8 px-18 font-bold" id="btnCalculateTg20Single">
                  <i class="fa-solid fa-calculator"></i> TG-20 Kotunu Hesapla
                </button>
                <button type="button" class="btn btn-secondary text-xs py-8 px-12 text-cyan border-cyan"
                  id="btnCopyTg20SingleReport">
                  <i class="fa-solid fa-copy"></i> Tek Nokta Raporunu Kopyala
                </button>
              </div>

              <!-- Single Result Card (4-Pill Bento Stat Grid) -->
              <div id="cardTg20SingleResult" class="tg20-stat-grid">
                <div class="tg20-stat-chip">
                  <span class="tg20-stat-label"><i class="fa-solid fa-location-dot text-cyan"></i> WGS-84 Konum:</span>
                  <strong id="resTg20LatLon" class="tg20-stat-val text-white stat-val-fs115">39.920800° K,
                    32.854100° D</strong>
                </div>
                <div class="tg20-stat-chip">
                  <span class="tg20-stat-label"><i class="fa-solid fa-arrows-up-down text-cyan"></i> Elipsoit Kotu
                    (h):</span>
                  <strong id="resTg20ElipH" class="tg20-stat-val text-cyan">900.000 m</strong>
                </div>
                <div class="tg20-stat-chip tg20-stat-chip-amber">
                  <span class="tg20-stat-label text-amber"><i class="fa-solid fa-wave-square"></i> TG-20 Jeoidi
                    (N):</span>
                  <strong id="resTg20N" class="tg20-stat-val text-amber">+35.926 m</strong>
                </div>
                <div class="tg20-stat-chip tg20-stat-chip-emerald">
                  <span class="tg20-stat-label text-emerald"><i class="fa-solid fa-mountain-sun"></i> Ortometrik Kot (H
                    =
                    h - N):</span>
                  <strong id="resTg20OrthH" class="tg20-stat-val text-emerald">864.074 m</strong>
                </div>
              </div>
            </div>

            <!-- Card 2: Bölgesel Jeoit Dağılımı Bilgi Kutusu -->
            <div class="card d-flex flex-col justify-between">
              <div class="card-header mb-0">
                <div class="card-title">
                  <i class="fa-solid fa-earth-americas text-emerald"></i>
                  <span data-i18n="tg20.guideCardTitle"></span>
                </div>
                <div class="d-flex gap-6">
                  <span class="badge badge-cyan text-xs" data-i18n="tg20.badgeGridCount"></span>
                  <span class="badge badge-emerald text-xs" data-i18n="ui.1X1Cozunurluk"></span>
                </div>
              </div>

              <div class="text-sm text-dim leading-relaxed d-flex flex-col gap-8">
                <div class="tg20-formula-card">
                  <div class="d-flex items-center gap-8 font-mono text-xs">
                    <span class="badge badge-cyan font-bold">H = h - N</span>
                    <span class="text-white" data-i18n="ui.ortometrikKotElipsoitKotu"></span>
                  </div>
                  <span class="badge badge-emerald text-xs font-mono">TUDKA-99</span>
                </div>
                <div class="tg20-regions-grid">
                  <div class="tg20-region-chip">
                    <span class="text-dim" data-i18n="ui.egeBolgesi"></span> <strong class="text-emerald font-bold">~38 - 40
                      m</strong>
                  </div>
                  <div class="tg20-region-chip">
                    <span class="text-dim" data-i18n="ui.iCAnadolu"></span> <strong class="text-emerald font-bold">~34 - 37
                      m</strong>
                  </div>
                  <div class="tg20-region-chip">
                    <span class="text-dim">🏛️ Marmara:</span> <strong class="text-emerald font-bold">~28 - 32
                      m</strong>
                  </div>
                  <div class="tg20-region-chip">
                    <span class="text-dim">🌲 Karadeniz:</span> <strong class="text-emerald font-bold">~21 - 25
                      m</strong>
                  </div>
                </div>
                <div class="text-xs text-muted">
                  💡 <em data-i18n="ui.bohhbuyStandardindaGnssNivelman"></em>
                </div>
              </div>
            </div>

          </div>

          <!-- Bottom Row: Batch Point List & Report Table -->
          <div class="card">
            <div class="card-header">
              <div class="card-title">
                <i class="fa-solid fa-list-ol text-emerald"></i>
                <span data-i18n="ui.topluNoktaListesiKadastro"></span>
              </div>
              <div class="d-flex gap-6 items-center flex-wrap">
                <button type="button" class="btn btn-secondary btn-sm text-xs py-4 px-10" id="btnLoadTg20SamplePoints" data-i18n="ui.ornekNoktalariYukle"></button>
                <label class="btn btn-secondary btn-sm m-0 cursor-pointer text-xs py-4 px-10">
                  <i class="fa-solid fa-folder-open text-cyan"></i> Dosyadan Yükle (.TXT/.CSV/.NCN)
                  <input type="file" id="fileTg20BatchInput" accept=".txt,.ncn,.csv,.dat" class="d-none" />
                </label>
              </div>
            </div>

            <div class="d-flex flex-col gap-10">
              <div class="text-xs text-dim">
                <i class="fa-solid fa-circle-info text-cyan mr-4"></i>
                Giriş Formatı: <code data-i18n="ui.noktaadiEnlemLatBoylam"></code> (Boşluk, tab veya noktalı
                virgül ile ayrılmış satırlar)
              </div>

              <textarea id="txtTg20BatchInput" rows="5"
                placeholder="ANKARA_KIZILAY   39.920800   32.854100   900.000&#10;ISTANBUL_TAKSIM  41.037000   28.985000   100.000&#10;IZMIR_KONAK      38.419200   27.128700    50.000&#10;ANTALYA_KALEICI  36.884100   30.705600    60.000&#10;TRABZON_MEYDAN   41.002700   39.716800    40.000&#10;DIYARBAKIR_SUR   37.914400   40.230600   650.000"
                class="batch-textarea"></textarea>

              <!-- Action & Main Report Toolbar (Clean & Elegant) -->
              <div class="tg20-action-toolbar">
                <div class="d-flex gap-8 items-center flex-wrap">
                  <button type="button" class="btn btn-primary py-7 px-18 font-bold text-xs" id="btnProcessTg20Batch">
                    <i class="fa-solid fa-bolt"></i> Tüm Noktaları TG-20 ile İndirge
                  </button>
                  <span id="lblTg20BatchSummary" class="text-xs font-semibold text-emerald font-mono"></span>
                </div>

                <!-- Clean Export Action Group -->
                <div class="tg20-batch-actions items-center">
                  <button type="button" class="btn btn-secondary btn-sm text-xs badge-region-cyan" id="btnPrintTg20Report">
                    <i class="fa-solid fa-file-pdf text-cyan"></i> PDF Raporu
                  </button>
                  <button type="button" class="btn btn-secondary btn-sm text-xs badge-region-purple" id="btnExportTg20Ncn">
                    <i class="fa-solid fa-vector-square text-purple"></i> Netcad (.ncn)
                  </button>
                  <button type="button" class="btn btn-secondary btn-outline-emerald btn-sm text-xs" id="btnExportTg20Csv">
                    <i class="fa-solid fa-file-csv text-emerald"></i> Excel (.csv)
                  </button>
                  <button type="button" class="btn btn-secondary btn-outline-amber btn-sm text-xs" id="btnExportTg20ReportTxt">
                    <i class="fa-solid fa-file-lines text-amber"></i> Metin (.txt)
                  </button>
                </div>
              </div>

              <!-- Batch Results Table -->
              <div id="wrapperTg20BatchResults" class="d-none flex-col gap-10 w-100 mt-10">
                <div class="table-container table-scroll-350 w-100">
                  <table class="table-hover w-100">
                    <thead>
                      <tr>
                        <th class="th-w-40px">#</th>
                        <th data-i18n="ui.noktaAdi"></th>
                        <th>Enlem (WGS-84)</th>
                        <th>Boylam (WGS-84)</th>
                        <th data-i18n="geomatics.ellipsoidalHeight"></th>
                        <th class="text-amber">TG-20 Jeoidi (N)</th>
                        <th class="text-emerald" data-i18n="geomatics.orthometricHeight"></th>
                        <th data-i18n="cadastre.thStatus"></th>
                      </tr>
                    </thead>
                    <tbody id="tbodyTg20BatchResults">
                      <!-- Batch calculated rows rendered dynamically -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- ================= SUB-TAB PANE 2: PANORAMIC INTERACTIVE TG-20 MAP ================= -->
        <div id="tg20PaneMap" class="tg20-pane">
          <div class="card tg20-interactive-map-card p-0 overflow-hidden">
            <div class="card-header p-14 border-b border-white/10 d-flex items-center justify-between flex-wrap gap-8">
              <div class="card-title">
                <i class="fa-solid fa-map-location-dot text-amber"></i>
                <span data-i18n="ui.iNteraktifTg20"></span>
                <span class="badge badge-amber text-xs font-mono ml-6">1' x 1' Grid Enterpolasyonu</span>
              </div>
              <div class="d-flex items-center gap-10">
                <span class="text-xs text-dim d-none-mobile d-inline-flex items-center gap-8">
                  <i class="fa-solid fa-hand-pointer text-cyan"></i>
                  <span data-i18n="ui.haritadaTurkiyeSinirlariIcinde"></span>
                </span>
                <button type="button" class="btn btn-secondary btn-sm text-xs py-4 px-12" id="btnTg20MapResetView"
                  title="Türkiye'ye Odakla">
                  <i class="fa-solid fa-expand text-cyan"></i> Türkiye Geneli
                </button>
              </div>
            </div>

            <div class="pos-rel w-100">
              <!-- Full Height Panoramic Map Container (570px) -->
              <div id="tg20MapContainer" class="tg20-map-canvas"></div>

              <!-- Floating Luxury GIS Telemetry Panel (Corner Docked, Never Blocks the Grid) -->
              <div id="tg20MapLiveHud" class="tg20-map-hud-badge">
                <div class="d-flex items-center gap-10">
                  <div class="tg20-hud-icon-box">
                    <i class="fa-solid fa-wave-square text-amber text-lg"></i>
                  </div>
                  <div class="d-flex flex-col">
                    <span class="text-2xs uppercase tracking-wider text-dim font-bold" data-i18n="ui.tg20JeoitOndulasyonu"></span>
                    <div class="d-flex items-baseline gap-6">
                      <span id="tg20HudNValue"
                        class="text-xl font-mono font-extrabold text-amber text-glow-amber">+--.--- m</span>
                      <span id="tg20HudStatus" class="badge badge-emerald text-2xs" data-i18n="ui.hazir"></span>
                    </div>
                  </div>
                </div>

                <div class="tg20-hud-divider"></div>

                <div class="d-flex flex-col gap-2 text-xs">
                  <div class="d-flex items-center gap-6">
                    <span class="text-dim">WGS-84:</span>
                    <strong id="tg20HudLatLon" class="font-mono text-cyan" data-i18n="ui.haritadaBirNoktayaTiklayin"></strong>
                  </div>
                  <div class="d-flex items-center gap-6">
                    <span class="text-dim">TM 3° / Pafta:</span>
                    <strong id="tg20HudTmPafta" class="font-mono text-white">--</strong>
                  </div>
                </div>

                <div class="tg20-hud-divider"></div>

                <div class="d-flex items-center gap-6">
                  <button type="button" id="btnSendTg20MapToSingle"
                    class="btn btn-primary btn-sm text-xs py-4 px-12 font-bold"
                    title="Bu koordinatı Tek Nokta Hesaplayıcıya aktar">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Hesaplayıcıya Aktar
                  </button>
                  <button type="button" id="btnCopyTg20HudN"
                    class="btn btn-secondary btn-sm text-xs py-4 px-10 text-amber border-amber font-bold"
                    title="Ondülasyon (N) değerini kopyala">
                    <i class="fa-solid fa-copy"></i> Kopyala
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

      </section>

      <section id="tab-flight" class="tool-tab">

        <!-- Action Toolbar & Quick Ingest -->
        <div class="card flight-header-card">
          <div class="flight-toolbar-wrap d-flex items-center justify-between gap-12 text-nowrap">
            <!-- Left: Ingest & Atmospheric Simulation Controls -->
            <div class="d-flex items-center gap-8 flex-shrink-0 text-nowrap">
              <label
                class="btn btn-primary btn-sm m-0 cursor-pointer d-inline-flex items-center gap-6 py-6 px-12 text-sm text-nowrap">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <span data-i18n="flight.btnUploadBoundaryShort"></span>
                <input type="file" id="inputFlightFile" accept=".kml,.kmz,.geojson,.json" class="d-none" />
              </label>

              <button class="btn btn-secondary btn-sm py-6 px-10 text-sm text-nowrap" id="btnLoadDemoFlightKml"
                type="button" data-tooltip="Örnek çalışma sahası sınırını yükler">
                <i class="fa-solid fa-wand-magic-sparkles text-amber"></i>
                <span data-i18n="common.example"></span>
              </button>

              <div class="interactive-date-control" id="wrapperFlightDatePicker"
                title="Uçuş Tarihini Değiştir (Güneş & 15 Günlük Canlı Tahmin)">
                <i class="fa-solid fa-calendar-days text-cyan text-xs"></i>
                <span class="text-xs font-extrabold uppercase tracking-wide text-dim" data-i18n="common.date"></span>
                <input type="date" id="flightDatePicker" class="custom-flight-date-input text-xs flight-date-input-w"
                  title="Tarih seç (Maks 15 gün)" />
                <i class="fa-solid fa-chevron-down text-cyan pointer-events-none calendar-overlay-icon"></i>
              </div>

              <!-- Flight Time Slider -->
              <div class="flight-time-slider-box">
                <i class="fa-solid fa-clock text-amber text-xs"></i>
                <span class="text-xs font-bold text-dim uppercase" data-i18n="common.time"></span>
                <span id="txtToolbarFlightTime" class="text-sm font-extrabold font-mono text-amber flight-time-badge">11:00</span>
                <input type="range" id="sliderToolbarFlightTime" min="360" max="1200" step="15" value="660"
                  class="accent-amber cursor-pointer flight-time-slider" title="Uçuş saatini kaydır" />
              </div>
            </div>

            <!-- Right: Single-Button Luxury Export Dropdown -->
            <div class="dropdown-export-wrap pos-rel flex-shrink-0 flight-export-z">
              <button class="btn btn-secondary btn-sm flight-export-btn" id="btnToggleExportMenu"
                onclick="window.toggleExportDropdown(event)" type="button">
                <i class="fa-solid fa-download text-cyan"></i>
                <span class="font-bold" data-i18n="common.export"></span>
                <i class="fa-solid fa-chevron-down text-cyan flight-chevron-sm"></i>
              </button>

              <!-- Dropdown Menu Popup -->
              <div id="menuExportDropdown" class="flight-export-menu">
                <button class="export-menu-item" id="btnExportFlightKml" onclick="window.exportFlightFile('dji_kml')"
                  type="button" title="DJI Pilot 2 Uçuş Sahası Sınırı (KML)">
                  <i class="fa-solid fa-file-code text-cyan text-md text-center export-icon-w16"></i>
                  <div class="d-flex flex-col">
                    <span class="font-bold text-sm text-white" data-i18n="flight.btnExportDjiKml"></span>
                    <span class="text-xs text-dim" data-i18n="flight.exportDescBoundary"></span>
                  </div>
                </button>
                <button class="export-menu-item" id="btnExportGcpNcn" onclick="window.exportFlightFile('netcad_ncn')"
                  type="button" title="Netcad Nokta Dosyası">
                  <i class="fa-solid fa-map-pin text-emerald text-md text-center export-icon-w16"></i>
                  <div class="d-flex flex-col">
                    <span class="font-bold text-sm text-white">Netcad (.NCN)</span>
                    <span class="text-xs text-dim" data-i18n="flight.exportDescNcn"></span>
                  </div>
                </button>
                <button class="export-menu-item" id="btnExportGcpDxf" onclick="window.exportFlightFile('autocad_dxf')"
                  type="button" title="AutoCAD Çizim Dosyası">
                  <i class="fa-solid fa-vector-square text-indigo text-md text-center export-icon-w16"></i>
                  <div class="d-flex flex-col">
                    <span class="font-bold text-sm text-white">AutoCAD (.DXF)</span>
                    <span class="text-xs text-dim" data-i18n="flight.exportDescDxf"></span>
                  </div>
                </button>
                <button class="export-menu-item" id="btnExportGcpCsv" onclick="window.exportFlightFile('excel_csv')"
                  type="button" title="Excel Koordinat Tablosu">
                  <i class="fa-solid fa-file-csv text-emerald text-md text-center export-icon-w16"></i>
                  <div class="d-flex flex-col">
                    <span class="font-bold text-sm text-white">Excel (.CSV)</span>
                    <span class="text-xs text-dim" data-i18n="flight.exportDescCsv"></span>
                  </div>
                </button>
                <button class="export-menu-item" id="btnExportGcpKml" onclick="window.exportFlightFile('google_kml')"
                  type="button" title="Google Earth Noktaları">
                  <i class="fa-solid fa-earth-americas text-amber text-md text-center export-icon-w16"></i>
                  <div class="d-flex flex-col">
                    <span class="font-bold text-sm text-white">Google Earth (.KML)</span>
                    <span class="text-xs text-dim" data-i18n="flight.exportDescKml"></span>
                  </div>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- 1. FULL-WIDTH PANORAMIC FLIGHT MAP (TOP) -->
        <div class="card flight-map-card p-0 overflow-hidden">
          <div class="flight-map-wrapper pos-rel w-full">

            <!-- Mobile Map Tools Trigger Button (Only visible on <= 900px) -->
            <button type="button" id="btnFlightMapMenuToggle" class="map-mobile-menu-toggle d-none" aria-label="Harita Araçları" title="Harita Araçları & Katman Menüsü">
              <i class="fa-solid fa-layer-group text-cyan"></i>
              <span data-i18n="common.tools"></span>
              <i class="fa-solid fa-chevron-down text-xs text-cyan" id="iconFlightMapMenuChevron"></i>
            </button>

            <!-- Floating / Dropdown Map Toolbar -->
            <div class="map-floating-toolbar" id="mapControlToolbar">
              <div class="map-toolbar-mobile-header d-none">
                <span class="text-xs font-bold text-white"><i class="fa-solid fa-screwdriver-wrench text-cyan mr-4"></i> Harita Araçları</span>
              </div>

              <div class="map-toolbar-actions-group">
                <button class="map-btn-compact" id="btnFlightFitBounds" type="button" title="Alana Yaklaş / Sığdır">
                  <i class="fa-solid fa-expand text-cyan"></i> <span data-i18n="ui.alanaSigdir"></span>
                </button>

                <button class="map-btn-compact" id="btnFetchRoadsNow" type="button" title="OSM Yol Ağını Canlı İndir">
                  <i class="fa-solid fa-cloud-arrow-down text-indigo"></i> <span id="txtRoadBtn" data-i18n="ui.yolINdir"></span>
                </button>

                <button class="map-btn-compact border-amber text-amber" id="btnDrawCustomRoad" type="button"
                  title="Uyduda Görünen Toprak Yolu Tıklayarak Çiz">
                  <i class="fa-solid fa-pen-nib"></i> <span id="txtDrawRoadBtn" data-i18n="flight.btnDrawRoad"></span>
                </button>

                <button class="map-btn-compact hidden d-none bg-emerald border-emerald text-white" id="btnFinishDrawRoad"
                  type="button">
                  <i class="fa-solid fa-check"></i> <span data-i18n="ui.cizimiBitir"></span>
                </button>
                <button class="map-btn-compact hidden d-none text-rose border-rose" id="btnCancelDrawRoad" type="button">
                  <i class="fa-solid fa-xmark"></i> <span data-i18n="ui.iPtal"></span>
                </button>

                <button class="map-btn-compact" id="btnUploadRoadFile" type="button"
                  title="Dış Yol Dosyası Yükle (KML/GeoJSON)">
                  <i class="fa-solid fa-folder-plus text-cyan"></i> <span data-i18n="ui.kmlYukle"></span>
                </button>
                <input type="file" id="inputCustomRoadFile" accept=".kml,.kmz,.geojson,.json" class="d-none" />
              </div>

              <div class="map-toolbar-divider"></div>

              <!-- Minimalist Layer Toggles -->
              <div class="map-layer-toggles-container">
                <div class="map-layer-toggles-row">
                  <button class="map-toggle-btn active" id="btnToggleRoadNetwork" type="button"
                    title="Yol Katmanı (Açık/Kapalı)">
                    <i class="fa-solid fa-road text-indigo"></i>
                  </button>
                  <button class="map-toggle-btn active" id="btnToggleGcpPins" type="button"
                    title="YKN / DN Pinleri (Açık/Kapalı)">
                    <i class="fa-solid fa-map-pin text-emerald"></i>
                  </button>
                  <button class="map-toggle-btn active" id="btnToggleTriangles" type="button"
                    title="Üçgenleme Ağı (Açık/Kapalı)">
                    <i class="fa-solid fa-shapes text-cyan"></i>
                  </button>
                  <button class="map-toggle-btn active" id="btnToggleFlightLines" type="button"
                    title="Uçuş Hatları & Rota (Açık/Kapalı)">
                    <i class="fa-solid fa-plane text-sky"></i>
                  </button>
                  <button class="map-toggle-btn active" id="btnToggleWaypoints" type="button"
                    title="Fotoğraf Tetikleme / Pozlama Noktaları (Açık/Kapalı)">
                    <i class="fa-solid fa-camera text-amber"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- Compact Wind Heading Badge (Positioned safely left of Leaflet Layer Switcher) -->
            <div id="overlayWindHeadingBadge" class="flight-wind-heading-badge">
              <i class="fa-solid fa-compass text-emerald text-xs"></i>
              <span>Hat: <strong id="txtOptimalHeadingVal" class="text-cyan font-mono">--</strong></span>
            </div>

            <!-- The Panoramic Map Canvas -->
            <div id="flightMapContainer" class="flight-map-canvas w-full"></div>
          </div>

          <!-- Docked Solar, Altitude-Wind & Cloud Quality Indicator Bar -->
          <div id="widgetSolarWindCompass" class="flight-solar-compass-widget">

            <!-- 1. Solar & Shadow Dial -->
            <div class="solar-wind-chip">
              <div class="solar-dial-circle">
                <span class="pos-abs top-1 text-2xs font-extrabold text-dim">K</span>
                <span class="pos-abs right-2 text-2xs font-extrabold text-dim">D</span>
                <span class="pos-abs bottom-1 text-2xs font-extrabold text-dim">G</span>
                <span class="pos-abs left-2 text-2xs font-extrabold text-dim">B</span>

                <div id="dialSunPointer" class="pos-abs w-full h-full top-0 left-0 d-flex items-center justify-center">
                  <div class="pos-abs top-2 d-flex flex-col items-center">
                    <i class="fa-solid fa-sun text-amber dial-sun-glow-icon"></i>
                    <div class="dial-sun-needle"></div>
                  </div>
                </div>
                <div class="rounded-full bg-white z-5 dial-center-dot-white"></div>
              </div>

              <div class="d-flex flex-col gap-1 text-xs">
                <div class="d-flex items-center gap-4">
                  <span class="text-dim text-xs font-bold uppercase" data-i18n="ui.gunes"></span>
                  <strong id="lblWidgetSunAzimuth" class="text-amber font-mono text-sm">145° (GD)</strong>
                  <span id="lblWidgetSunElev" class="text-xs text-dim font-mono">(54°)</span>
                </div>
                <div class="d-flex items-center gap-4">
                  <span class="text-dim text-xs font-bold uppercase" data-i18n="ui.golge"></span>
                  <strong id="lblWidgetShadowMult" class="text-purple font-mono text-sm">0.7x Boy</strong>
                </div>
              </div>
            </div>

            <!-- Vertical Divider -->
            <div class="solar-wind-divider"></div>

            <!-- 2. Altitude-Aware Wind Dial -->
            <div class="solar-wind-chip">
              <div class="wind-dial-circle">
                <span class="pos-abs top-1 text-2xs font-extrabold text-dim">K</span>
                <span class="pos-abs right-2 text-2xs font-extrabold text-dim">D</span>
                <span class="pos-abs bottom-1 text-2xs font-extrabold text-dim">G</span>
                <span class="pos-abs left-2 text-2xs font-extrabold text-dim">B</span>

                <div id="dialWindPointer" class="pos-abs w-full h-full top-0 left-0 d-flex items-center justify-center">
                  <div class="pos-abs top-3 d-flex flex-col items-center">
                    <i class="fa-solid fa-arrow-up text-cyan dial-wind-glow-icon"></i>
                    <div class="dial-wind-needle"></div>
                  </div>
                </div>
                <div class="rounded-full bg-sky z-5 dial-center-dot-white"></div>
              </div>

              <div class="d-flex flex-col gap-1 text-xs">
                <div class="d-flex items-center gap-4">
                  <span class="text-dim text-xs font-bold uppercase">Rüzgar (<span id="lblWidgetFlightAlt"
                      class="text-cyan">100m</span>):</span>
                  <strong id="lblWidgetWindSpeed" class="text-cyan font-mono text-sm">2.4 m/s (8.6 km/sa)</strong>
                </div>
                <div class="d-flex items-center gap-4">
                  <span class="text-dim text-xs font-bold uppercase" data-i18n="ui.yon"></span>
                  <strong id="lblWidgetWindDir" class="text-white font-mono text-xs">45° (KD)</strong>
                  <span id="lblWidgetWindSafety" class="text-xs text-emerald font-bold" data-i18n="ui.iDeal"></span>
                </div>
              </div>
            </div>

            <!-- Vertical Divider -->
            <div class="solar-wind-divider"></div>

            <!-- 3. Real-Time Cloud Cover & Lighting Quality -->
            <div class="solar-wind-chip">
              <div class="cloud-indicator-circle">
                <i class="fa-solid fa-cloud-sun text-sky cloud-indicator-icon" id="iconWidgetCloud"></i>
              </div>
              <div class="d-flex flex-col gap-1 text-xs">
                <div class="d-flex items-center gap-4">
                  <span class="text-dim text-xs font-bold uppercase">Bulut:</span>
                  <strong id="lblWidgetCloudCover" class="text-sky font-mono text-sm">%15</strong>
                  <span id="lblWidgetCloudDesc" class="text-xs text-dim font-mono" data-i18n="flight.lblCloudClear"></span>
                </div>
                <div class="d-flex items-center gap-4">
                  <span class="text-dim text-xs font-bold uppercase" data-i18n="ui.isik"></span>
                  <span id="lblWidgetLightCondition" class="text-xs text-emerald font-bold" data-i18n="flight.lblLightSunny"></span>
                </div>
              </div>
            </div>

            <!-- Weather Source Badge -->
            <div class="d-none d-md-flex items-center gap-4 border-l border-white/10 pl-8" id="badgeWeatherLiveSource"
              title="Open-Meteo ECMWF / DWD Küresel Meteoroloji Modeli">
              <span class="status-indicator-dot online weather-dot"></span>
              <span class="text-2xs text-muted font-mono" id="txtWeatherDataSource" data-i18n="ui.canliEcmwf"></span>
            </div>

          </div>

        </div>

        <!-- 2. THREE WORKFLOW CARDS SIDE-BY-SIDE UNDER MAP (BALANCED EQUAL-HEIGHT BENTO GRID) -->
        <div class="flight-bottom-cards-grid mb-16">

          <!-- Panel 1: Uçuş Sahası & Sınır Sadeleştirme -->
          <div class="card flight-workflow-card flight-workflow-card-cyan">
            <div class="card-header py-10 px-14 border-b border-white/10 d-flex items-center justify-between">
              <div class="card-title text-sm d-flex items-center gap-8">
                <i class="fa-solid fa-draw-polygon text-cyan"></i>
                <span data-i18n="flight.step1Title"></span>
              </div>
              <span class="text-xs py-2 px-8 rounded-sm bg-cyan-15 text-cyan font-bold border-cyan" data-i18n="ui.sinirSadelestirme"></span>
            </div>
            <div class="card-body p-14 d-flex flex-col gap-10">
              <!-- Sadeleştirme Kaydıracı (Genişletilmiş & Şık Konteyner) -->
              <div class="flight-slider-container">
                <div class="flight-slider-header">
                  <span class="text-dim font-semibold d-flex items-center gap-4">
                    <i class="fa-solid fa-sliders text-cyan"></i> <span data-i18n="ui.sinirSadelestirme"></span>
                  </span>
                  <span id="txtSimplificationLevel" class="text-cyan font-bold font-mono">Dengeli (%50)</span>
                </div>
                <input type="range" id="sliderSimplification" min="0" max="100" value="50" step="5"
                  class="flight-slider" />
                <div class="flight-slider-labels">
                  <span data-i18n="ui.hamSinir"></span>
                  <span>Dengeli</span>
                  <span>Maksimum Sade</span>
                </div>
              </div>

              <!-- Katman Görünürlük Butonları -->
              <div class="d-flex gap-8">
                <button class="btn btn-secondary btn-sm flex-1 text-xs py-6 px-10" id="btnToggleOriginalLayer"
                  type="button">
                  <i class="fa-solid fa-eye"></i> <span data-i18n="ui.hamSinir"></span>
                </button>
                <button class="btn btn-secondary btn-sm flex-1 text-xs py-6 px-10 border-cyan text-cyan"
                  id="btnToggleSimplifiedLayer" type="button">
                  <i class="fa-solid fa-eye"></i> <span data-i18n="ui.sadeSinir"></span>
                </button>
              </div>

              <!-- Saha Geometrisi & Alan Özeti -->
              <div class="flight-geo-matrix">
                <div class="flight-geo-chip">
                  <span class="flight-geo-label"><i class="fa-solid fa-vector-square text-cyan"></i> Kırık / Köşe</span>
                  <span class="flight-geo-val text-cyan" id="statFlightVertices" data-i18n="ui.kose"></span>
                </div>
                <div class="flight-geo-chip">
                  <span class="flight-geo-label"><i class="fa-solid fa-ruler-combined text-emerald"></i> Çevre</span>
                  <span class="flight-geo-val text-emerald" id="statFlightPerimeter">-- m</span>
                </div>
                <div class="flight-geo-chip">
                  <span class="flight-geo-label"><i class="fa-solid fa-chart-area text-amber"></i> Saha Alanı</span>
                  <span class="flight-geo-val text-amber" id="statFlightArea">-- ha</span>
                </div>
                <div class="flight-geo-chip">
                  <span class="flight-geo-label"><i class="fa-solid fa-bolt text-purple"></i> Kırık Azaltma</span>
                  <span class="flight-geo-val text-purple" id="statFlightGain">-- Tasarruf</span>
                </div>
              </div>

              <!-- Geometri & Alan Emniyeti Özet Kutusu -->
              <div class="flight-summary-box">
                <div>
                  <span class="text-muted" data-i18n="ui.alanFarki"></span>
                  <strong class="text-emerald font-mono" id="kpiAreaDiff">(+%0.0)</strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.sinirDurumu"></span>
                  <strong class="text-cyan font-mono" id="badgeFlightSimplification" data-i18n="ui.sadelestirilmisSinir"></strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.sahaKapsama"></span>
                  <strong class="text-emerald font-mono" data-i18n="ui.100AlanKapsama"></strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.manevraAlani"></span>
                  <strong class="text-white font-mono" data-i18n="ui.donusKoridoruDahil"></strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.ucusSahasi"></span>
                  <strong class="text-cyan font-mono" id="kpiAreaDisplay" data-i18n="ui.hazir"></strong>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel 2: YKN & Yol Ağına Bağlama Motoru -->
          <div class="card flight-workflow-card flight-workflow-card-indigo">
            <div class="card-header py-10 px-14 border-b border-white/10 d-flex items-center justify-between">
              <div class="card-title text-sm d-flex items-center gap-8">
                <i class="fa-solid fa-route text-indigo"></i>
                <span data-i18n="ui.2YknDagitimiYol"></span>
              </div>
              <span class="text-xs py-2 px-8 rounded-sm bg-indigo-20 text-indigo font-bold border-indigo" data-i18n="ui.bohhbuyYolAgi"></span>
            </div>
            <div class="card-body p-14 d-flex flex-col gap-10">
              <div class="flight-inputs-grid-2x2">
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-dim mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-ruler-horizontal text-dim"></i> <span data-i18n="ui.maksYknAraligi"></span>
                  </label>
                  <div class="input-unit-group">
                    <input type="number" id="inputMaxGcpDistance" value="1000" min="200" max="5000" step="50"
                      class="form-input flight-compact-input" />
                    <span class="input-unit-suffix flight-unit-suffix">m</span>
                  </div>
                </div>
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-dim mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-chart-pie text-dim"></i> <span data-i18n="ui.yknDnOrani"></span>
                  </label>
                  <select id="selectGcpRatio" class="form-input form-select flight-compact-select">
                    <option value="0.75" selected>%75 YKN / %25 DN</option>
                    <option value="0.80">%80 YKN / %20 DN</option>
                    <option value="0.67">%67 YKN / %33 DN</option>
                    <option value="1.00">%100 Sadece YKN</option>
                  </select>
                </div>
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-cyan mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-arrows-to-dot text-cyan"></i> <span data-i18n="ui.iCEmniyetMesafesi"></span>
                  </label>
                  <div class="input-unit-group">
                    <input type="number" id="inputInwardOffset" value="100" min="20" max="500" step="10"
                      class="form-input flight-compact-input" />
                    <span class="input-unit-suffix flight-unit-suffix">m</span>
                  </div>
                </div>
                <div class="form-group m-0">
                  <div class="d-flex justify-between items-center mb-2 flight-label-row-h16">
                    <label class="text-xs font-semibold text-dim m-0 d-flex items-center gap-4 cursor-pointer"
                      for="chkSnapToRoads">
                      <input type="checkbox" id="chkSnapToRoads" checked
                        class="flight-checkbox-sm" />
                      <i class="fa-solid fa-road text-indigo"></i> <span data-i18n="ui.yolBaglantisi"></span>
                    </label>
                  </div>
                  <div class="input-unit-group">
                    <input type="number" id="inputSnapMaxRadius" value="300" min="20" max="2000" step="25"
                      class="form-input text-indigo border-indigo font-bold flight-compact-input" />
                    <span class="input-unit-suffix text-indigo flight-unit-suffix">m</span>
                  </div>
                </div>
              </div>

              <!-- YKN Kalite & Standart Matrisi -->
              <div class="flight-geo-matrix">
                <div class="flight-geo-chip">
                  <span class="flight-geo-label"><i class="fa-solid fa-map-pin text-emerald"></i> Yer Kontrol
                    (YKN)</span>
                  <span class="flight-geo-val text-emerald" id="statTargetGcpCount">-- YKN</span>
                </div>
                <div class="flight-geo-chip">
                  <span class="flight-geo-label"><i class="fa-solid fa-crosshairs text-amber"></i> Denetim (DN)</span>
                  <span class="flight-geo-val text-amber" id="statTargetChkCount">-- DN</span>
                </div>
                <div class="flight-geo-chip">
                  <span class="flight-geo-label"><i class="fa-solid fa-shapes text-cyan"></i> Nokta Aralığı</span>
                  <span class="flight-geo-val text-cyan" id="statTriangleSpacing">~1000 m</span>
                </div>
                <div class="flight-geo-chip">
                  <span class="flight-geo-label"><i class="fa-solid fa-road text-indigo"></i> Yol Yaklaşımı</span>
                  <span class="flight-geo-val text-indigo" id="statSnapDistance">Maks 300 m</span>
                </div>
              </div>

              <button class="btn btn-primary btn-flight-generate-gcp" id="btnGenerateGCPs" type="button">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <span data-i18n="ui.yknDnNoktalariniDagit"></span>
              </button>

              <!-- Jeodezi & GNSS Standart Kutusu -->
              <div class="flight-summary-box">
                <div>
                  <span class="text-muted" data-i18n="sidebar.geoidModel"></span>
                  <strong class="text-emerald font-mono">🇹🇷 TG-20 (HGM)</strong>
                </div>
                <div>
                  <span class="text-muted">Projeksiyon:</span>
                  <strong class="text-cyan font-mono">TUREF / ITRF-96 TM 3°</strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.noktaDagilimi"></span>
                  <strong class="text-white font-mono" id="kpiGcpCount">0 YKN + 0 DN</strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.yolaBaglama"></span>
                  <strong class="text-indigo font-mono" id="badgeGcpRoadSnap" data-i18n="ui.yolAgiAktif"></strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.konumDuzenleme"></span>
                  <strong class="text-amber font-mono" data-i18n="ui.haritadaTasinabilir"></strong>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel 3: İHA, GSD & Uçuş Planlayıcı -->
          <div class="card flight-workflow-card flight-workflow-card-emerald">
            <div class="card-header py-10 px-14 border-b border-white/10 d-flex items-center justify-between">
              <div class="card-title text-sm d-flex items-center gap-8">
                <i class="fa-solid fa-camera text-emerald"></i>
                <span data-i18n="ui.3IHaGsd"></span>
              </div>
              <span class="text-xs py-2 px-8 rounded-sm bg-emerald-20 text-emerald font-bold border-emerald" data-i18n="ui.ucusBindirme"></span>
            </div>
            <div class="card-body p-14 d-flex flex-col gap-10">
              <!-- İHA Modeli & Kamera (2 Sütun) -->
              <div class="flight-inputs-grid-2x2">
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-dim mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-plane-up text-dim"></i> <span data-i18n="ui.iHaModeli"></span>
                  </label>
                  <select id="selectDroneModel" class="form-input form-select flight-compact-select">
                  </select>
                </div>
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-dim mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-camera text-dim"></i> <span data-i18n="ui.kameraSensor"></span>
                  </label>
                  <select id="selectDroneCamera" class="form-input form-select flight-compact-select">
                  </select>
                </div>
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-cyan mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-arrows-up-down text-cyan"></i> <span data-i18n="ui.ucusYuksekligiAgl"></span>
                  </label>
                  <div class="input-unit-group">
                    <input type="number" id="inputFlightAltitude" value="100" min="5" max="2500" step="1"
                      class="form-input text-cyan border-cyan font-bold flight-compact-input" />
                    <span class="input-unit-suffix text-cyan flight-unit-suffix">m</span>
                  </div>
                </div>
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-cyan mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-bullseye text-cyan"></i> <span data-i18n="ui.yerOrneklemeGsd"></span>
                  </label>
                  <div class="input-unit-group">
                    <input type="number" id="inputTargetGsd" value="2.73" min="0.1" max="50" step="0.05"
                      class="form-input text-cyan border-cyan font-bold flight-compact-input" />
                    <span class="input-unit-suffix text-cyan flight-unit-suffix">cm</span>
                  </div>
                </div>
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-dim mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-gauge-high text-dim"></i> <span data-i18n="ui.ucusHizi"></span>
                  </label>
                  <div class="input-unit-group">
                    <input type="number" id="inputFlightSpeed" value="12" min="1" max="35" step="0.5" class="form-input flight-compact-input" />
                    <span class="input-unit-suffix flight-unit-suffix">m/s</span>
                  </div>
                </div>
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-dim mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-battery-half text-dim"></i> <span data-i18n="ui.bataryaSuresi"></span>
                  </label>
                  <div class="input-unit-group">
                    <input type="number" id="inputSafeBatteryDuration" value="32" min="5" max="120" step="1"
                      class="form-input flight-compact-input" />
                    <span class="input-unit-suffix flight-unit-suffix">dk</span>
                  </div>
                </div>
              </div>

              <!-- Live Drone Speed & Wind Limit Telemetry Chips -->
              <div class="flight-telemetry-badge-grid flight-overlap-row" id="lblDroneSpeedLimitBadge">
                <div class="flight-telemetry-chip">
                  <span data-i18n="ui.maksHiz"></span>
                  <strong class="text-cyan" id="valBadgeMaxSpeed">15 m/s</strong>
                </div>
                <div class="flight-telemetry-chip">
                  <span data-i18n="ui.onerilenHiz"></span>
                  <strong class="text-emerald" id="valBadgeRecSpeed">12 m/s</strong>
                </div>
                <div class="flight-telemetry-chip">
                  <span data-i18n="ui.maksRuzgar"></span>
                  <strong class="text-amber" id="valBadgeMaxWind">12 m/s</strong>
                </div>
              </div>

              <!-- Bindirmeler & Hat Açısı -->
              <div class="flight-inputs-grid-2x2">
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-dim mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-arrows-up-down text-dim"></i> <span>Boyuna Bindirme:</span>
                  </label>
                  <div class="input-unit-group">
                    <input type="number" id="inputForwardOverlap" value="80" min="50" max="90" step="5"
                      class="form-input flight-compact-input" />
                    <span class="input-unit-suffix flight-unit-suffix-pct">%</span>
                  </div>
                </div>
                <div class="form-group m-0">
                  <label class="text-xs font-semibold text-dim mb-2 d-flex items-center gap-4">
                    <i class="fa-solid fa-arrows-left-right text-dim"></i> <span>Enine Bindirme:</span>
                  </label>
                  <div class="input-unit-group">
                    <input type="number" id="inputSideOverlap" value="70" min="40" max="85" step="5" class="form-input flight-compact-input" />
                    <span class="input-unit-suffix flight-unit-suffix-pct">%</span>
                  </div>
                </div>
              </div>

              <!-- Hat Açısı (Doğrultu) & Optimal Eksen Seçici -->
              <div class="flight-heading-box">
                <div class="d-flex justify-between items-center">
                  <label class="text-xs font-semibold text-cyan m-0 d-flex items-center gap-6">
                    <i class="fa-solid fa-compass"></i> <span data-i18n="ui.ucusHatYonu"></span> <span id="txtFlightHeadingVal"
                      class="font-mono text-white text-xs ml-2">--°</span>
                  </label>
                  <div class="d-flex items-center gap-4">
                    <button class="btn btn-secondary btn-sm text-xs py-2 px-8 text-emerald border-emerald flight-heading-btn-sm"
                      id="btnAutoOptimalHeading" type="button"
                      title="En Az Dönüşlü Uzun Eksene Göre Otomatik Hizala">
                      <i class="fa-solid fa-wand-magic-sparkles"></i> Uzun Eksen
                    </button>
                    <button class="btn btn-secondary btn-sm text-xs py-2 px-8 text-cyan border-cyan flight-heading-btn-sm"
                      id="btnWindAlignHeading" type="button"
                      title="Canlı Rüzgar Yönüne Göre Hizala">
                      <i class="fa-solid fa-wind"></i> Rüzgar Yönü
                    </button>
                  </div>
                </div>
                <div class="d-flex items-center gap-8">
                  <input type="range" id="sliderFlightHeading" min="0" max="359" value="0" step="1"
                    class="flight-slider" />
                  <div class="input-unit-group flight-heading-wrap">
                    <input type="number" id="inputFlightHeading" value="0" min="0" max="359" step="1"
                      class="form-input text-center text-xs flight-compact-heading-input" />
                    <span class="input-unit-suffix flight-heading-suffix">°</span>
                  </div>
                </div>
              </div>

              <!-- Hesaplanan Uçuş & Telemetri Çıktısı -->
              <div class="flight-summary-box">
                <div>
                  <span class="text-muted" data-i18n="ui.ucusYuksekligi"></span>
                  <strong id="resCalcAltitude" class="text-cyan font-mono">100 m AGL | GSD: 2.73 cm</strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.ucusHatlari"></span>
                  <strong id="resCalcGridLines" class="text-white font-mono" data-i18n="ui.hatAralikM"></strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.toplamHatUzunlugu"></span>
                  <strong id="resCalcPathLength" class="text-white font-mono">-- km</strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.kameraCekimi"></span>
                  <strong id="resCalcPhotos" class="text-white font-mono" data-i18n="ui.fotograf"></strong>
                </div>
                <div>
                  <span class="text-muted" data-i18n="ui.tahminiUcusSuresi"></span>
                  <strong id="resCalcDuration" class="text-emerald font-mono">-- Dk / Batarya</strong>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Full-Width Operational Field Note Below Cards -->
        <div class="card p-12 mb-16 bg-black/50 border border-white/10 d-flex items-center gap-10">
          <i class="fa-solid fa-circle-info text-cyan text-lg flex-shrink-0"></i>
          <div class="text-xs text-muted leading-relaxed">
            <strong class="text-cyan">Operasyonel Saha Bilgilendirmesi:</strong> Hesaplanan süre salt haritalama hatları
            üzerindeki taramayı kapsar. Kalkış noktasından ilk hatta intikal, irtifaya tırmanma, rüzgar direnci ve RTH
            (eve dönüş / iniş) manevralarına bağlı olarak toplam operasyonel uçuş süresi sahada bir miktar değişkenlik
            gösterebilir.
          </div>
        </div>

      </section>

      <!-- ================= TAB: EVRENSEL DOSYA & FORMAT DÖNÜŞTÜRÜCÜ STUDIO ================= -->
      <section id="tab-converter" class="tool-tab">
        <div class="converter-workstation">

          <!-- Top Action / Status Bar -->
          <div class="converter-top-bar card p-3 mb-2">
            <div class="d-flex justify-between items-center flex-wrap gap-8">
              <div class="d-flex items-center gap-10">
                <div class="converter-icon-box">
                  <i class="fa-solid fa-arrows-rotate text-cyan"></i>
                </div>
                <div>
                  <h3 class="m-0 text-sm font-bold text-white" data-i18n="converter.headerTitle"></h3>
                  <span class="text-xs text-dim" data-i18n="converter.headerDesc"></span>
                </div>
              </div>

              <!-- Top Status Badges -->
              <div class="d-flex items-center gap-6">
                <span class="badge badge-cyan font-mono"><i class="fa-solid fa-bolt"></i> %100 Çevrimdışı</span>
                <span class="badge badge-emerald font-mono"><i class="fa-solid fa-layer-group"></i> Çoklu Katman</span>
                <span class="badge badge-purple font-mono" id="badgeConverterCrs">TUREF TM 3° (DOM: 30°)</span>
              </div>
            </div>
          </div>

          <!-- Main Layout: Split Grid -->
          <div class="converter-workspace-grid">

            <!-- Left Panel: Upload, Settings & Polygon Tools -->
            <div class="converter-left-pane">

              <!-- 1. Universal Dropzone -->
              <div class="card p-3">
                <div class="card-title text-xs font-bold text-dim mb-2 uppercase d-flex items-center gap-6">
                  <i class="fa-solid fa-cloud-arrow-up text-cyan"></i> <span data-i18n="converter.step1Title"></span>
                </div>

                <div class="converter-dropzone" id="converterDropzone">
                  <i class="fa-solid fa-file-arrow-up converter-drop-icon"></i>
                  <div class="converter-drop-title" data-i18n="converter.dropzoneLabel"></div>
                  <div class="converter-drop-tags">
                    <span class="converter-tag-pill">NCZ</span>
                    <span class="converter-tag-pill">DXF</span>
                    <span class="converter-tag-pill">KML</span>
                    <span class="converter-tag-pill">KMZ</span>
                    <span class="converter-tag-pill">NCN</span>
                    <span class="converter-tag-pill">GeoJSON</span>
                    <span class="converter-tag-pill">TXT / CSV</span>
                  </div>
                  <input type="file" id="inputConverterFile" accept=".ncz,.dxf,.kml,.kmz,.ncn,.kos,.txt,.csv,.xyz,.dat,.geojson,.json" />
                </div>

                <!-- Active File Info Chip (Hidden initially) -->
                <div class="converter-file-info-chip d-none mt-2" id="converterFileInfo">
                  <div class="d-flex items-center gap-8">
                    <div class="converter-file-icon-box" id="converterFileIcon">
                      <i class="fa-solid fa-file-lines text-cyan"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="text-xs font-bold text-white truncate" id="txtConverterFileName" data-i18n="ui.dosyaDxf"></div>
                      <div class="text-2xs text-dim" id="txtConverterFileDetails">AutoCAD DXF • 0 Geometri</div>
                    </div>
                    <button type="button" class="btn btn-xs btn-secondary" id="btnResetConverter" title="Temizle">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>
                </div>
              </div>

              <!-- 2. Reprojection & Coordinate Settings -->
              <div class="card p-3">
                <div class="card-title text-xs font-bold text-dim mb-2 uppercase d-flex items-center gap-6">
                  <i class="fa-solid fa-globe text-purple"></i> <span data-i18n="converter.step2Title"></span>
                </div>

                <div class="form-grid grid-2 gap-8">
                  <div class="form-group mb-0">
                    <label class="form-label" data-i18n="common.sourceSystem"></label>
                    <select id="selConverterSrcCrs" class="form-select form-select-sm">
                      <option value="TUREF_TM" selected>ITRF-96 / TUREF TM 3° (Metre)</option>
                      <option value="WGS84" data-i18n="ui.wgs84CografiEnlem"></option>
                      <option value="ED50_TM" data-i18n="ui.ed50GaussKruger"></option>
                    </select>
                  </div>

                  <div class="form-group mb-0">
                    <label class="form-label">Dilim Orta Meridyeni (DOM):</label>
                    <select id="selConverterDom" class="form-select form-select-sm">
                      <option value="27">27° (Dilim 1 / 9)</option>
                      <option value="30" selected>30° (Dilim 2 / 10)</option>
                      <option value="33">33° (Dilim 3 / 11)</option>
                      <option value="36">36° (Dilim 4 / 12)</option>
                      <option value="39">39° (Dilim 5 / 13)</option>
                      <option value="42">42° (Dilim 6 / 14)</option>
                      <option value="45">45° (Dilim 7 / 15)</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- 3. Point-to-Polygon & Area Generation Engine -->
              <div class="card p-3 d-flex flex-col gap-10">
                <div class="d-flex justify-between items-center">
                  <div class="card-title text-xs font-bold text-dim uppercase d-flex items-center gap-6 m-0">
                    <i class="fa-solid fa-draw-polygon text-emerald"></i> <span data-i18n="converter.sectionAreaGen"></span>
                  </div>
                  <span class="badge badge-secondary font-mono text-3xs" data-i18n="ui.akilliAlan"></span>
                </div>

                <div class="text-2xs text-dim lh-145" data-i18n="converter.sectionAreaGenDesc"></div>

                <div>
                  <label class="form-label" data-i18n="converter.lblAreaMethod"></label>
                  <div class="d-flex gap-6 w-100" id="converterPolygonModeGroup">
                    <button type="button" class="btn btn-primary btn-sm flex-1 text-xs" data-mode="sequential" id="btnModeSequential">
                      <i class="fa-solid fa-arrow-down-1-9"></i> Sıralı Dizi
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm flex-1 text-xs" data-mode="convex_hull" id="btnModeConvexHull">
                      <i class="fa-solid fa-shapes"></i> Dış Çeper (Hull)
                    </button>
                  </div>
                </div>

                <button type="button" class="btn btn-primary btn-sm w-100" id="btnGeneratePolygon">
                  <i class="fa-solid fa-wand-magic-sparkles"></i> <span data-i18n="converter.btnCreateArea"></span>
                </button>
              </div>

              <!-- 4. Layers & Visibility Control -->
              <div class="card p-3">
                <div class="d-flex justify-between items-center mb-2">
                  <div class="card-title text-xs font-bold text-dim uppercase d-flex items-center gap-6">
                    <i class="fa-solid fa-layer-group text-cyan"></i> <span>4. Katmanlar (Layers)</span>
                  </div>
                  <span class="text-3xs text-dim font-mono" id="lblLayerCount">0 Katman</span>
                </div>

                <div class="converter-layers-list" id="converterLayersList">
                  <div class="text-center py-3 text-xs text-dim" data-i18n="converter.noLayersLoaded"></div>
                </div>
              </div>

            </div>

            <!-- Right Panel: Visualization, Map, KPI & Export -->
            <div class="converter-right-pane">

              <!-- Telemetry & KPI Cards -->
              <div class="converter-kpi-grid">
                <div class="converter-kpi-card">
                  <div class="converter-kpi-icon bento-icon-cyan"><i class="fa-solid fa-location-dot"></i></div>
                  <div>
                    <div class="converter-kpi-val text-cyan" id="kpiConverterPoints">0</div>
                    <div class="converter-kpi-lbl" data-i18n="ui.noktaSayisi"></div>
                  </div>
                </div>

                <div class="converter-kpi-card">
                  <div class="converter-kpi-icon bento-icon-purple"><i class="fa-solid fa-font"></i></div>
                  <div>
                    <div class="converter-kpi-val text-purple" id="kpiConverterTexts">0</div>
                    <div class="converter-kpi-lbl" data-i18n="ui.yaziCadMetni"></div>
                  </div>
                </div>

                <div class="converter-kpi-card">
                  <div class="converter-kpi-icon bento-icon-blue"><i class="fa-solid fa-route"></i></div>
                  <div>
                    <div class="converter-kpi-val text-blue" id="kpiConverterLines">0</div>
                    <div class="converter-kpi-lbl" data-i18n="converter.kpiLines"></div>
                  </div>
                </div>

                <div class="converter-kpi-card">
                  <div class="converter-kpi-icon bento-icon-emerald"><i class="fa-solid fa-draw-polygon"></i></div>
                  <div>
                    <div class="converter-kpi-val text-emerald" id="kpiConverterPolygons">0</div>
                    <div class="converter-kpi-lbl" data-i18n="geomatics.closedArea"></div>
                  </div>
                </div>
              </div>

              <!-- Interactive Map Viewport -->
              <div class="converter-map-container card">
                <div class="converter-map-header">
                  <div class="d-flex items-center gap-6">
                    <span class="status-indicator-dot online"></span>
                    <span class="converter-map-title" data-i18n="ui.iNteraktifVektorHarita"></span>
                  </div>
                  <div class="d-flex items-center gap-6">
                    <button type="button" class="btn btn-xs btn-secondary" id="btnConverterFitBounds" title="Haritayı Geometrilere Sığdır">
                      <i class="fa-solid fa-expand"></i> <span data-i18n="cadastre.btnFit"></span>
                    </button>
                    <button type="button" class="btn btn-xs btn-secondary active text-purple" id="btnConverterToggleTexts" title="CAD Metinlerini Aç / Kapat">
                      <i class="fa-solid fa-font"></i> <span data-i18n="converter.tabTextsOnly"></span>
                    </button>
                    <button type="button" class="btn btn-xs btn-secondary" id="btnConverterToggleLabels" title="Nokta İsimlerini Aç / Kapat">
                      <i class="fa-solid fa-tag"></i> <span data-i18n="cadastre.btnLabels"></span>
                    </button>
                  </div>
                </div>
                <div id="converterMap" class="converter-leaflet-map"></div>
              </div>

              <!-- Output & Export Toolbar -->
              <div class="card converter-export-card">
                <div class="d-flex justify-between items-center flex-wrap gap-8">
                  <div class="converter-export-tag">
                    <i class="fa-solid fa-file-export text-emerald"></i>
                    <span data-i18n="ui.donusturDisaAktar"></span>
                  </div>

                  <div class="converter-export-btns" id="converterExportButtons">
                    <button type="button" class="btn-converter-export btn-soft-cyan" id="btnExportDxf" title="AutoCAD / Netcad DXF Olarak İndir">
                      <i class="fa-solid fa-file-code text-cyan"></i> <span data-i18n="cadastre.btnExportDxf"></span>
                    </button>
                    <button type="button" class="btn-converter-export" id="btnExportKml" title="Google Earth KML Olarak İndir">
                      <i class="fa-solid fa-earth-americas text-emerald"></i> <span data-i18n="cadastre.btnExportKml"></span>
                    </button>
                    <button type="button" class="btn-converter-export" id="btnExportKmz" title="Sıkıştırılmış Google Earth KMZ Olarak İndir">
                      <i class="fa-solid fa-file-zipper text-purple"></i> <span data-i18n="ui.kmzINdir"></span>
                    </button>
                    <button type="button" class="btn-converter-export" id="btnExportNcn" title="Netcad Nokta Dosyası (.NCN) Olarak İndir">
                      <i class="fa-solid fa-hashtag text-cyan"></i> <span data-i18n="cadastre.btnExportNcn"></span>
                    </button>
                    <button type="button" class="btn-converter-export" id="btnExportGeoJson" title="GIS / Coğrafi Bilgi Sistemi GeoJSON Olarak İndir">
                      <i class="fa-solid fa-code text-amber"></i> <span>.GeoJSON</span>
                    </button>
                    <button type="button" class="btn-converter-export" id="btnExportCsv" title="Excel / CSV Formatında İndir">
                      <i class="fa-solid fa-table text-rose"></i> <span>.CSV</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Geometry & Point Data Table Preview -->
              <div class="card p-3">
                <div class="converter-table-toolbar">
                  <div class="d-flex items-center gap-8">
                    <div class="card-title text-xs font-bold text-white uppercase d-flex items-center gap-6 m-0">
