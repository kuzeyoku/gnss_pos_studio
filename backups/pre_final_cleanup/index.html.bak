      </section>

      <!-- ================= TAB 4: GEODESY & UNIVERSAL EPSG WORKSTATION ================= -->
      <section id="tab-geodesy" class="tool-tab">

        <!-- ================= CARD 1: SINGLE POINT INTERACTIVE CONVERTER ================= -->
        <div class="card d-flex flex-col gap-14">
          <div class="card-header mb-0 pb-4">
            <div class="card-title">
              <i class="fa-solid fa-compass-drafting text-cyan"></i>
              <span data-i18n="geodesy.tabSinglePoint"></span>
            </div>
            <div class="d-flex gap-6">
              <span class="badge badge-cyan" data-i18n="geodesy.badgeTurefEd50"></span>
            </div>
          </div>

          <div class="geodesy-crs-grid">
            <!-- Source CRS -->
            <div>
              <label class="label-form-section mb-4" data-i18n="geodesy.lblSourceCrs"></label>
              <select id="selSourceEpsg" class="select-glass"></select>
            </div>

            <!-- Swap Button -->
            <div class="d-flex items-center justify-center">
              <button type="button" id="btnSwapEpsg" class="btn-swap-crs" title="Kaynak ve Hedef Sistemleri Değiştir">
                <i class="fa-solid fa-right-left"></i>
              </button>
            </div>

            <!-- Target CRS -->
            <div>
              <label class="label-form-section mb-4 text-emerald" data-i18n="geodesy.lblTargetCrs"></label>
              <select id="selTargetEpsg" class="select-glass border-cyan"></select>
            </div>
          </div>

          <!-- Cross-Datum Info Alert -->
          <div id="crossDatumWarningBanner" class="alert-datum-warning d-none">
            <i class="fa-solid fa-circle-info text-cyan mr-4"></i>
            <strong data-i18n="geodesy.geodeticInfoLabel"></strong> ITRF-96 (GRS80) ile ED-50 (Hayford) farklı datumlardır. Dilimler arası (DOM
            27°..45°) ve 3° ↔ 6° dönüşümleri <strong>%100 matematiksel kesinliktedir</strong>. Datumlar arası geçişte
            ise yerel 7 parametre (Bursa-Wolf) uygulanır.
          </div>

          <!-- Optional 7-Parameter Panel Toggle -->
          <details class="text-sm text-dim">
            <summary class="cursor-pointer text-cyan font-semibold py-4 d-flex items-center justify-between">
              <span data-i18n="geodesy.paramBursaWolfCustom"></span>
              <span class="text-xs text-purple font-semibold" data-i18n="geodesy.btnCalcFrom3dPoints"></span>
            </summary>
            <div class="bursa-details-box">
              <!-- Manual Inputs Grid -->
              <div class="d-grid gap-6 grid-cols-7">
                <div><span class="text-xs text-dim" data-i18n="geodesy.dxLabel"></span><input type="number" id="p_dx" value="-84.1"
                    step="0.001" class="bursa-param-input" /></div>
                <div><span class="text-xs text-dim" data-i18n="geodesy.dyLabel"></span><input type="number" id="p_dy" value="-101.8"
                    step="0.001" class="bursa-param-input" /></div>
                <div><span class="text-xs text-dim" data-i18n="geodesy.dzLabel"></span><input type="number" id="p_dz" value="-129.7"
                    step="0.001" class="bursa-param-input" /></div>
                <div><span class="text-xs text-dim" data-i18n="geodesy.rxLabel"></span><input type="number" id="p_rx" value="0.0"
                    step="0.0001" class="bursa-param-input" /></div>
                <div><span class="text-xs text-dim" data-i18n="geodesy.ryLabel"></span><input type="number" id="p_ry" value="0.0"
                    step="0.0001" class="bursa-param-input" /></div>
                <div><span class="text-xs text-dim" data-i18n="geodesy.rzLabel"></span><input type="number" id="p_rz" value="0.0"
                    step="0.0001" class="bursa-param-input" /></div>
                <div><span class="text-xs text-dim" data-i18n="geodesy.scaleLabel"></span><input type="number" id="p_ds" value="0.0"
                    step="0.001" class="bursa-param-input" /></div>
              </div>

              <!-- 3D Common Control Points Auto-Solver (Collapsible Inside) -->
              <details class="details-bursa">
                <summary class="summary-bursa" data-i18n="geodesy.paramAutoCalcTitle"></summary>
                <div class="mt-1 d-flex flex-col gap-6">
                  <div class="text-xs text-dim d-flex justify-between items-center">
                    <span>Format: <code>NoktaNo  X_ITRF  Y_ITRF  Z_ITRF  X_ED50  Y_ED50  Z_ED50</code> (en az 3
                      nokta)</span>
                    <button type="button" class="btn btn-secondary btn-sm text-xs py-2 px-6"
                      id="btnLoadBursaWolfSample" data-i18n="geodesy.btnSample4Points"></button>
                  </div>
                  <textarea id="txtBursaWolfCommonPoints" rows="3"
                    placeholder="P1  4123450.000  2654320.000  4098760.000  4123365.900  2654218.200  4098630.300&#10;P2  4125600.000  2651200.000  4100100.000  4125515.800  2651098.300  4099970.200&#10;P3  4121200.000  2658900.000  4095400.000  4121116.100  2658798.100  4095270.400"
                    class="batch-textarea min-h-70"></textarea>
                  <div class="d-flex justify-between items-center">
                    <button type="button" class="btn btn-primary btn-sm py-4 px-10 text-xs" id="btnSolveBursaWolf">
                      <i class="fa-solid fa-calculator"></i> 7 Parametreyi Hesapla & Uygula
                    </button>
                    <span id="lblBursaWolfM0" class="text-xs font-bold text-emerald font-mono"></span>
                  </div>
                </div>
              </details>
            </div>
          </details>

          <!-- Coordinate Inputs & Result Row -->
          <div class="d-grid gap-14 grid-split-11-10">
            <!-- Inputs -->
            <div class="d-flex flex-col gap-10">
              <div class="d-grid gap-8 grid-cols-3">
                <div>
                  <label id="lblInputC1" class="text-xs font-bold uppercase text-dim d-block mb-3">Enlem (Lat / Y /
                    X):</label>
                  <input type="text" id="geoLat" value="38.74561234" class="geo-coord-input" />
                </div>
                <div>
                  <label id="lblInputC2" class="text-xs font-bold uppercase text-dim d-block mb-3">Boylam (Lon / X /
                    Y):</label>
                  <input type="text" id="geoLon" value="30.54321987" class="geo-coord-input" />
                </div>
                <div>
                  <label id="lblInputC3" class="text-xs font-bold uppercase text-dim d-block mb-3" data-i18n="ui.kotYukseklikHZ"></label>
                  <input type="text" id="geoH" value="1050.250" class="geo-coord-input" />
                </div>
              </div>

              <div class="d-flex gap-6 flex-wrap">
                <button class="btn btn-primary flex-1 py-8 px-12 text-xs font-bold" id="btnConvertCoord">
                  <i class="fa-solid fa-arrows-rotate"></i> Hassas Dönüştür
                </button>
                <button class="btn btn-secondary py-8 px-8 text-xs" id="btnCopySingleCoordResult"
                  title="Dönüşüm Raporunu Kopyala">
                  <i class="fa-solid fa-copy"></i> Kopyala
                </button>
                <button class="btn btn-secondary btn-outline-emerald py-8 px-8 text-xs" id="btnCopySingleTg20"
                  title="TG-20 için Enlem Boylam Kot Kopyala">
                  <i class="fa-solid fa-clipboard-check"></i> TG-20 Kopyala
                </button>
                <button class="btn btn-secondary btn-soft-emerald py-8 px-8 text-xs" id="btnSendSingleToTg20"
                  title="Doğrudan TG-20 sekmesine aktar ve hesapla">
                  <i class="fa-solid fa-mountain-sun"></i> TG-20'ye Gönder ➔
                </button>
              </div>
            </div>

            <!-- Output Box -->
            <div>
              <div class="console-box coord-result-display" id="coordResultBox" data-i18n="ui.donusumSonucunuGormekIcin"></div>
            </div>
          </div>
        </div>

        <!-- ================= CARD 2: BATCH LIST & FILE TRANSFORMER ================= -->
        <div class="card d-flex flex-col gap-12">

          <!-- Card Header & Delimiter -->
          <div class="card-header mb-0 pb-2">
            <div class="card-title">
              <i class="fa-solid fa-table-list text-purple"></i>
              <span data-i18n="ui.2TopluListeDosya"></span>
            </div>
            <div class="d-flex items-center gap-6">
              <span class="text-xs font-bold text-dim uppercase" data-i18n="ui.ayirici"></span>
              <select id="selBatchDelimiter" class="select-glass w-auto py-2 px-8 text-xs">
                <option value="AUTO" selected data-i18n="ui.otomatikAlgila"></option>
                <option value="SPACE" data-i18n="ui.boslukSpace"></option>
                <option value="COMMA" data-i18n="ui.virgul"></option>
                <option value="SEMICOLON" data-i18n="ui.noktaliVirgul"></option>
                <option value="TAB">Tab (\t)</option>
              </select>
            </div>
          </div>

          <!-- Quick 6° <-> 3° Presets Bar -->
          <div class="preset-template-bar">
            <span class="text-xs font-bold text-cyan d-flex items-center gap-4"><i class="fa-solid fa-bolt"></i> Hızlı
              Şablonlar:</span>
            <button type="button" class="btn-quick-epsg" data-src="EPSG:32636" data-tgt="EPSG:5255">6° UTM 36 ➔ 3° TM
              33</button>
            <button type="button" class="btn-quick-epsg" data-src="EPSG:32635" data-tgt="EPSG:5253">6° UTM 35 ➔ 3° TM
              27</button>
            <button type="button" class="btn-quick-epsg" data-src="EPSG:32637" data-tgt="EPSG:5257">6° UTM 37 ➔ 3° TM
              39</button>
            <button type="button" class="btn-quick-epsg" data-src="EPSG:5255" data-tgt="EPSG:32636">3° TM 33 ➔ 6° UTM
              36</button>
            <button type="button" class="btn-quick-epsg" data-src="EPSG:23036" data-tgt="EPSG:5265">ED50 6° 36 ➔ ED50 3°
              33</button>
          </div>

          <!-- Source & Target Projection Selectors -->
          <div class="geodesy-crs-grid">
            <!-- Batch Source CRS -->
            <div>
              <label class="label-form-section mb-4" data-i18n="ui.girdiDosyasininKaynakProjeksiyonu"></label>
              <select id="selBatchSourceEpsg" class="select-glass"></select>
            </div>

            <!-- Batch Swap Button -->
            <div class="d-flex items-center justify-center">
              <button type="button" id="btnSwapBatchEpsg" class="btn-swap-crs"
                title="Kaynak ve Hedef Projeksiyonu Değiştir">
                <i class="fa-solid fa-right-left"></i>
              </button>
            </div>

            <!-- Batch Target CRS -->
            <div>
              <label class="label-form-section mb-4 text-emerald" data-i18n="ui.ciktininHedefProjeksiyonu"></label>
              <select id="selBatchTargetEpsg" class="select-glass border-cyan"></select>
            </div>
          </div>

          <!-- Main Input & Configuration Row (2 Columns: Left=Data Input, Right=Column Mapping & Action) -->
          <div class="d-grid gap-14 grid-split-13-10">

            <!-- Left: Textarea & File Upload -->
            <div class="d-flex flex-col gap-6">
              <div class="d-flex justify-between items-center">
                <span class="text-xs font-bold text-dim uppercase">
                  📝 Koordinat Listesi Girdisi:
                </span>
                <label class="btn btn-secondary btn-outline-cyan btn-sm m-0 cursor-pointer text-xs py-2 px-8">
                  <i class="fa-solid fa-folder-open text-cyan"></i> Dosyadan Seç (.ncn, .txt, .csv, .xyz)
                  <input type="file" id="fileBatchInput" accept=".txt,.csv,.ncn,.dat,.xyz,.raw,.rw5" class="d-none" />
                </label>
              </div>
              <textarea id="txtBatchInput" rows="6"
                placeholder="Koordinatları buraya yapıştırın veya dosya seçin:&#10;56,599747.449,4132535.662,365.057&#10;59,599646.811,4132266.786,366.347&#10;61,599575.328,4132370.661,365.649&#10;P1  500120.000  4520100.000  125.400"
                class="batch-textarea min-h-120"></textarea>
            </div>

            <!-- Right: Column Mapping & Transform Button -->
            <div class="geodesy-panel-box d-flex flex-col justify-between gap-10">
              <div>
                <span class="text-xs font-bold text-cyan uppercase d-block mb-6">
                  <i class="fa-solid fa-table-columns"></i> Sütun Eşleştirme (Girdi Formatı):
                </span>
                <div class="d-grid gap-6 grid-cols-2">
                  <div>
                    <span class="text-xs text-dim d-block mb-2" data-i18n="ui.1Sutun"></span>
                    <select id="selCol1" class="col-select-glass">
                      <option value="PN" selected data-i18n="cadastre.btnLabels"></option>
                      <option value="C1" data-i18n="ui.ySagaEnlem"></option>
                      <option value="C2" data-i18n="ui.xYukariBoylam"></option>
                      <option value="C3" data-i18n="ui.zKotH"></option>
                    </select>
                  </div>
                  <div>
                    <span class="text-xs text-dim d-block mb-2" data-i18n="ui.2Sutun"></span>
                    <select id="selCol2" class="col-select-glass">
                      <option value="C1" selected data-i18n="ui.ySagaEnlem"></option>
                      <option value="C2" data-i18n="ui.xYukariBoylam"></option>
                      <option value="PN" data-i18n="cadastre.btnLabels"></option>
                      <option value="C3" data-i18n="ui.zKotH"></option>
                    </select>
                  </div>
                  <div>
                    <span class="text-xs text-dim d-block mb-2" data-i18n="ui.3Sutun"></span>
                    <select id="selCol3" class="col-select-glass">
                      <option value="C2" selected data-i18n="ui.xYukariBoylam"></option>
                      <option value="C1" data-i18n="ui.ySagaEnlem"></option>
                      <option value="C3" data-i18n="ui.zKotH"></option>
                      <option value="PN" data-i18n="cadastre.btnLabels"></option>
                    </select>
                  </div>
                  <div>
                    <span class="text-xs text-dim d-block mb-2" data-i18n="ui.4Sutun"></span>
                    <select id="selCol4" class="col-select-glass">
                      <option value="C3" selected data-i18n="ui.zKotH"></option>
                      <option value="CODE" data-i18n="ui.kodAciklama"></option>
                      <option value="NONE" data-i18n="ui.yokBos"></option>
                    </select>
                  </div>
                </div>
              </div>

              <button class="btn btn-primary py-9 px-14 text-sm font-bold w-100" id="btnBatchTransform">
                <i class="fa-solid fa-play"></i> Tüm Listeyi Dönüştür & Hazırla
              </button>
            </div>

          </div>

          <!-- Batch Results Table & Exports -->
          <div id="batchResultsWrapper" class="d-none mt-10 flex-col gap-10">
            <div class="d-flex justify-between items-center flex-wrap gap-8">
              <span id="lblBatchSummary" class="text-xs font-semibold text-emerald font-mono"></span>
              <div class="d-flex gap-6 flex-wrap">
                <button class="btn btn-secondary btn-outline-cyan btn-sm text-xs" id="btnExportBatchNcn">
                  <i class="fa-solid fa-file-export text-cyan"></i> Netcad (.ncn)
                </button>
                <button class="btn btn-secondary btn-outline-purple btn-sm text-xs" id="btnExportBatchDxf">
