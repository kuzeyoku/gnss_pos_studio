<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title data-i18n="app.title"></title>

  <!-- Google Fonts: Outfit, Plus Jakarta Sans, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <!-- Core Design System (High-Performance Consolidated Bundle) -->
  <link rel="stylesheet" href="css/core.css">

  <!-- JSZip for in-browser zipping -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>

<body>

  <!-- Mobile Backdrop Overlay -->
  <div id="mobileNavOverlay" class="mobile-nav-overlay"></div>

  <!-- Sidebar -->
  <aside class="sidebar" id="appSidebar">
    <button id="btnMobileSidebarClose" class="mobile-sidebar-close-btn" aria-label="" data-i18n-aria="sidebar.closeAria" type="button">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div class="brand">
      <div class="brand-icon">
        <i class="fa-solid fa-satellite-dish"></i>
        <span class="brand-signal-pulse"></span>
      </div>
      <div class="brand-info">
        <div class="brand-title-wrap">
          <h2 data-i18n="navigation.tabDashboard.title"></h2>
          <span class="badge-beta">BETA</span>
        </div>
        <span class="brand-subtitle"><span class="brand-live-dot"></span> <span data-i18n="sidebar.subTitle"></span></span>
      </div>
    </div>

    <div class="sidebar-nav-container">
      <div class="nav-section-title" data-i18n="sidebar.secCore"></div>
      <ul class="nav-menu">
        <li class="nav-item active" data-tab="tab-home">
          <i class="fa-solid fa-house"></i>
          <span data-i18n="sidebar.tabHome"></span>
        </li>
        <li class="nav-item" data-tab="tab-cadastre">
          <i class="fa-solid fa-table-cells"></i>
          <span data-i18n="sidebar.tabRtk"></span>
        </li>
        <li class="nav-item" data-tab="tab-rinex-studio">
          <i class="fa-solid fa-satellite"></i>
          <span data-i18n="sidebar.tabRinex"></span>
        </li>
        <li class="nav-item" data-tab="tab-map">
          <i class="fa-solid fa-map-location-dot"></i>
          <span data-i18n="sidebar.tabMap"></span>
        </li>
        <li class="nav-item" data-tab="tab-converter">
          <i class="fa-solid fa-arrows-rotate"></i>
          <span data-i18n="sidebar.tabConverter"></span>
          <span class="badge-beta ml-auto" data-i18n="sidebar.badgeNew"></span>
        </li>
      </ul>

      <div class="nav-section-title mt-8" data-i18n="sidebar.secGeodesy"></div>
      <ul class="nav-menu">
        <li class="nav-item" data-tab="tab-geodesy">
          <i class="fa-solid fa-compass-drafting"></i>
          <span data-i18n="sidebar.tabGeodesy"></span>
        </li>
        <li class="nav-item" data-tab="tab-flight">
          <i class="fa-solid fa-plane-up"></i>
          <span data-i18n="sidebar.tabFlight"></span>
        </li>
        <li class="nav-item" data-tab="tab-tg20">
          <i class="fa-solid fa-mountain-sun"></i>
          <span data-i18n="sidebar.tabTg20"></span>
        </li>
      </ul>

      <div class="nav-section-title mt-8" data-i18n="sidebar.secLegal"></div>
      <ul class="nav-menu">
        <li class="nav-item" data-tab="tab-standards">
          <i class="fa-solid fa-scale-balanced"></i>
          <span data-i18n="sidebar.tabStandards"></span>
        </li>
        <li class="nav-item" data-tab="tab-guide">
          <i class="fa-solid fa-book-bookmark"></i>
          <span data-i18n="sidebar.tabGuide"></span>
        </li>
      </ul>
    </div>

    <!-- Pinned Bottom Sidebar Dock -->
    <div class="sidebar-bottom-dock">
      <!-- Mini Geodetic HUD Card -->
      <div class="sidebar-geo-card">
        <div class="sidebar-geo-header">
          <div class="d-flex items-center gap-6">
            <i class="fa-solid fa-earth-europe text-cyan"></i>
            <span class="sidebar-geo-title" data-i18n="sidebar.geoStandard"></span>
          </div>
          <span class="sidebar-geo-pulse" title="" data-i18n-title="sidebar.sysSync"></span>
        </div>

        <div class="sidebar-geo-body">
          <div class="sidebar-geo-row">
            <span class="sidebar-geo-label" data-i18n="sidebar.datumRef"></span>
            <strong class="sidebar-geo-val text-white font-mono">ITRF-96 / GRS80</strong>
          </div>
          <div class="sidebar-geo-row">
            <span class="sidebar-geo-label" data-i18n="sidebar.geoidModel"></span>
            <strong class="sidebar-geo-val text-amber font-mono">HGM TG-20 (+N)</strong>
          </div>
          <div class="sidebar-geo-row">
            <span class="sidebar-geo-label" data-i18n="sidebar.projection"></span>
            <strong class="sidebar-geo-val text-cyan font-mono" data-i18n="ui.gaussKruger3"></strong>
          </div>

          <div class="sidebar-constellations">
            <span class="sidebar-sat-pill badge-sat-gps" title="GPS (ABD / NAVSTAR)">GPS</span>
            <span class="sidebar-sat-pill badge-sat-glo" title="GLONASS (Rusya)">GLO</span>
            <span class="sidebar-sat-pill badge-sat-gal" title="Galileo (Avrupa Birliği)">GAL</span>
            <span class="sidebar-sat-pill badge-sat-bds" title="BeiDou (Çin)">BDS</span>
          </div>
        </div>
      </div>

      <!-- Quick Shortcuts Card -->
      <div class="sidebar-shortcuts-card">
        <div class="sidebar-shortcut-row" onclick="document.getElementById('inputHomeHeroFile')?.click()" title="" data-i18n-title="sidebar.quickUpload">
          <div class="d-flex items-center gap-6">
            <i class="fa-solid fa-folder-open text-cyan text-xs"></i>
            <span data-i18n="sidebar.openFile"></span>
          </div>
          <kbd class="sidebar-kbd">Ctrl+O</kbd>
        </div>
        <div class="sidebar-shortcut-row" id="btnSidebarThemeShortcut" title="" data-i18n-title="sidebar.themeChange">
          <div class="d-flex items-center gap-6">
            <i class="fa-solid fa-circle-half-stroke text-amber text-xs"></i>
            <span data-i18n="sidebar.themeChange"></span>
          </div>
          <kbd class="sidebar-kbd">Ctrl+D</kbd>
        </div>
      </div>

      <!-- Sidebar Footer -->
      <div class="sidebar-footer">
        <div class="sidebar-footer-wrap">
          <span class="d-flex items-center gap-6"><i class="fa-solid fa-shield-halved text-emerald"></i> <span data-i18n="sidebar.localClient"></span></span>
          <button id="btnSidebarAbout" class="sidebar-about-btn">
            <i class="fa-solid fa-circle-info"></i> <span data-i18n="sidebar.aboutBtn"></span>
          </button>
        </div>
        <div data-i18n="sidebar.privacyNotice"></div>
      </div>
    </div>
  </aside>

  <!-- Main Wrapper -->
  <main class="main-wrapper">

    <!-- Top Header (Universal Single-Row Desktop & Mobile) -->
    <header class="top-header">
      <div class="header-left-group">
        <button type="button" id="btnMobileMenuToggle" class="mobile-menu-btn d-none" aria-label="Menüyü Aç" title="Menüyü Aç" data-i18n-aria="header.openMenu" data-i18n-title="header.openMenu">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div class="header-title">
          <h1 id="pageTitle" data-i18n="navigation.tabDashboard.title"></h1>
          <p id="pageSubtitle" data-i18n="navigation.tabDashboard.sub"></p>
        </div>
      </div>
      <div class="header-actions">
        <button class="btn btn-secondary btn-sm header-btn-icon" id="btnThemeToggle"
          data-tooltip="Tema Değiştir (Koyu / Açık)" title="" data-i18n-title="header.themeTitle">
          <i class="fa-solid fa-moon text-cyan" id="themeIcon"></i>
        </button>
        <button class="btn btn-secondary btn-sm header-btn-icon" id="btnOpenAboutModal"
          data-tooltip="Proje Künyesi & Bilgi" title="" data-i18n-title="header.aboutTitle">
          <i class="fa-solid fa-circle-info text-cyan"></i>
        </button>
        <div class="status-pill">
          <span class="status-dot"></span>
          <span id="brandDetectPill" data-i18n="header.statusReady"></span>
        </div>
      </div>
    </header>

    <!-- Content Body -->
    <div class="content-body">

      <!-- ================= TAB 0: PREMIUM HOMEPAGE DASHBOARD ================= -->
      <section id="tab-home" class="tool-tab active">

        <!-- Hero Welcome Banner -->
        <div class="home-hero-card">
          <div class="hero-content">
            <div class="hero-pill">
              <span class="hero-pill-dot"></span>
              <span data-i18n="home.heroPill"></span>
            </div>
            <h2 class="hero-title" data-i18n="home.heroTitle"></h2>
            <p class="hero-description" data-i18n="home.heroDesc"></p>
          </div>

          <!-- Hero Universal Fast Dropzone -->
          <div class="hero-quick-dropzone" id="homeHeroDropzone">
            <i class="fa-solid fa-cloud-arrow-up hero-drop-icon"></i>
            <div class="hero-drop-title" data-i18n="home.heroDropTitle"></div>
            <div class="hero-drop-sub" data-i18n="home.heroDropSub"></div>
            <div class="hero-drop-badge" data-i18n="home.heroDropBadge"></div>
            <input type="file" id="inputHomeHeroFile"
              accept=".rw5,.raw,.csv,.txt,.jxl,.dat,.o,.rnx,.crx,.obs,.ncn,.dns,.kml,.kmz,.geojson,.json" />
          </div>
        </div>

        <!-- Bento Grid of Tool Modules -->
        <div class="home-bento-grid">

          <!-- Bento Card 1: RTK & Ham Data -->
          <div class="bento-card" data-launch-tab="tab-cadastre">
            <div class="bento-card-header">
              <div class="bento-icon-box bento-icon-cyan">
                <i class="fa-solid fa-table-cells"></i>
              </div>

              <span class="bento-badge badge-cyan" data-i18n="home.rtkBadge"></span>
            </div>
            <h3 class="bento-title" data-i18n="home.rtkTitle"></h3>
            <p class="bento-desc" data-i18n="home.rtkDesc"></p>
            <div class="bento-features">
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.rtkFeat1"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.rtkFeat2"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.rtkFeat3"></span></span>
            </div>
            <div class="bento-footer">
              <button type="button" class="bento-action-btn"><span data-i18n="home.openModule"></span> <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Bento Card 2: İHA Uçuş Planlama & Akıllı YKN -->
          <div class="bento-card" data-launch-tab="tab-flight">
            <div class="bento-card-header">
              <div class="bento-icon-box bento-icon-cyan">
                <i class="fa-solid fa-plane-up"></i>
              </div>
              <span class="bento-badge badge-cyan" data-i18n="home.flightBadge"></span>
            </div>
            <h3 class="bento-title" data-i18n="home.flightTitle"></h3>
            <p class="bento-desc" data-i18n="home.flightDesc"></p>
            <div class="bento-features">
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.flightFeat1"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.flightFeat2"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.flightFeat3"></span></span>
            </div>
            <div class="bento-footer">
              <button type="button" class="bento-action-btn"><span data-i18n="home.openModule"></span> <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Bento Card 2: RINEX Düzenleyici -->
          <div class="bento-card" data-launch-tab="tab-rinex-studio">
            <div class="bento-card-header">
              <div class="bento-icon-box bento-icon-blue">
                <i class="fa-solid fa-satellite"></i>
              </div>
              <span class="bento-badge badge-blue" data-i18n="home.rinexBadge"></span>
            </div>
            <h3 class="bento-title" data-i18n="home.rinexTitle"></h3>
            <p class="bento-desc" data-i18n="home.rinexDesc"></p>
            <div class="bento-features">
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.rinexFeat1"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.rinexFeat2"></span></span>
            </div>
            <div class="bento-footer">
              <button type="button" class="bento-action-btn"><span data-i18n="home.openModule"></span> <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Bento Card 3: Pafta İndeksi & Harita -->
          <div class="bento-card" data-launch-tab="tab-map">
            <div class="bento-card-header">
              <div class="bento-icon-box bento-icon-purple">
                <i class="fa-solid fa-map-location-dot"></i>
              </div>
              <span class="bento-badge badge-purple" data-i18n="home.mapBadge"></span>
            </div>
            <h3 class="bento-title" data-i18n="home.mapTitle"></h3>
            <p class="bento-desc" data-i18n="home.mapDesc"></p>
            <div class="bento-features">
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.mapFeat1"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.mapFeat2"></span></span>
            </div>
            <div class="bento-footer">
              <button type="button" class="bento-action-btn"><span data-i18n="home.openModule"></span> <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Bento Card 4: Koordinat Dönüşümü & Helmert 2D -->
          <div class="bento-card" data-launch-tab="tab-geodesy">
            <div class="bento-card-header">
              <div class="bento-icon-box bento-icon-emerald">
                <i class="fa-solid fa-compass-drafting"></i>
              </div>
              <span class="bento-badge badge-emerald" data-i18n="home.geodesyBadge"></span>
            </div>
            <h3 class="bento-title" data-i18n="home.geodesyTitle"></h3>
            <p class="bento-desc" data-i18n="home.geodesyDesc"></p>
            <div class="bento-features">
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.geodesyFeat1"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.geodesyFeat2"></span></span>
            </div>
            <div class="bento-footer">
              <button type="button" class="bento-action-btn"><span data-i18n="home.openModule"></span> <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Bento Card 5: TG-20 Jeoit Kot İndirgeme -->
          <div class="bento-card" data-launch-tab="tab-tg20">
            <div class="bento-card-header">
              <div class="bento-icon-box bento-icon-amber">
                <i class="fa-solid fa-mountain-sun"></i>
              </div>
              <span class="bento-badge badge-amber" data-i18n="home.tg20Badge"></span>
            </div>
            <h3 class="bento-title" data-i18n="home.tg20Title"></h3>
            <p class="bento-desc" data-i18n="home.tg20Desc"></p>
            <div class="bento-features">
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.tg20Feat1"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.tg20Feat2"></span></span>
            </div>
            <div class="bento-footer">
              <button type="button" class="bento-action-btn"><span data-i18n="home.openModule"></span> <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Bento Card 6: Evrensel Format Dönüştürücü -->
          <div class="bento-card" data-launch-tab="tab-converter">
            <div class="bento-card-header">
              <div class="bento-icon-box bento-icon-cyan">
                <i class="fa-solid fa-arrows-rotate"></i>
              </div>
              <span class="bento-badge badge-cyan" data-i18n="home.converterBadge"></span>
            </div>
            <h3 class="bento-title" data-i18n="home.converterTitle"></h3>
            <p class="bento-desc" data-i18n="home.converterDesc"></p>
            <div class="bento-features">
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.converterFeat1"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.converterFeat2"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.converterFeat3"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.converterFeat4"></span></span>
            </div>
            <div class="bento-footer">
              <button type="button" class="bento-action-btn"><span data-i18n="home.openModule"></span> <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

          <!-- Bento Card 7: Resmi Mevzuat & Standartlar Kütüphanesi -->
          <div class="bento-card" data-launch-tab="tab-standards">
            <div class="bento-card-header">
              <div class="bento-icon-box bento-icon-emerald">
                <i class="fa-solid fa-scale-balanced"></i>
              </div>
              <span class="bento-badge badge-emerald" data-i18n="home.standardsBadge"></span>
            </div>
            <h3 class="bento-title" data-i18n="home.standardsTitle"></h3>
            <p class="bento-desc" data-i18n="home.standardsDesc"></p>
            <div class="bento-features">
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.standardsFeat1"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.standardsFeat2"></span></span>
              <span><i class="fa-solid fa-check"></i> <span data-i18n="home.standardsFeat3"></span></span>
            </div>
            <div class="bento-footer">
              <button type="button" class="bento-action-btn"><span data-i18n="home.openStandards"></span> <i class="fa-solid fa-arrow-right"></i></button>
            </div>
          </div>

        </div>

        <!-- Trust & Technical Feature Badges Bar -->
        <div class="home-trust-bar">
          <div class="trust-item">
            <i class="fa-solid fa-lock trust-icon"></i>
            <div>
              <strong data-i18n="home.trust1Title"></strong>
              <span data-i18n="home.trust1Desc"></span>
            </div>
          </div>
          <div class="trust-item">
            <i class="fa-solid fa-bolt trust-icon"></i>
            <div>
              <strong data-i18n="home.trust2Title"></strong>
              <span data-i18n="home.trust2Desc"></span>
            </div>
          </div>
          <div class="trust-item">
            <i class="fa-solid fa-file-shield trust-icon"></i>
            <div>
              <strong data-i18n="home.trust3Title"></strong>
              <span data-i18n="home.trust3Desc"></span>
            </div>
          </div>
        </div>

      </section>

      <!-- ================= TAB 1: GPSFORMAT STUDIO ================= -->
      <section id="tab-cadastre" class="tool-tab">
        <div class="card d-flex flex-col gap-16">

          <!-- Master Header -->
          <div class="card-header flex-wrap gap-12 mb-0 pb-12">
            <div class="card-title">
              <i class="fa-solid fa-table-cells text-cyan text-lg"></i>
              <span data-i18n="cadastre.headerTitle"></span>
            </div>
            <div class="d-flex gap-6 flex-wrap">
              <span class="badge badge-cyan text-xs font-bold" data-i18n="cadastre.badgeTusaga"></span>
              <span class="badge badge-emerald text-xs font-bold" data-i18n="cadastre.badgeTg20"></span>
              <span class="badge badge-purple text-xs font-bold" data-i18n="cadastre.badgeNcnDxf"></span>
            </div>
          </div>

          <!-- Section 1: Controls & Upload Bar Panel -->
          <div class="cadastre-config-panel">
            <div class="cadastre-controls-grid">
              <div>
                <label class="label-form-section mb-4" data-i18n="cadastre.lblGnssFile"></label>
                <div class="file-upload-glass h-32 d-flex items-center px-10 py-4" id="rw5UploadContainer">
                  <span id="rw5FileNameLabel"
                    class="text-sm text-main d-flex items-center gap-6 overflow-hidden text-ellipsis whitespace-nowrap">
                    <i class="fa-solid fa-folder-open text-cyan"></i> <span id="rw5FileDisplayName" data-i18n="cadastre.fileSelectOrDrag"></span>
                  </span>
                  <input type="file" id="rw5FileInput" accept=".rw5,.raw,.csv,.txt,.ncn,.jxl,.dat" />
                </div>
              </div>

              <div>
                <label class="label-form-section mb-4" data-i18n="cadastre.lblSamePointThreshold"></label>
                <div class="input-unit-group">
                  <input type="number" id="rw5Radius" value="1.0" step="0.1" min="0.1" max="10"
                    class="form-input text-xs h-32 px-8 py-4" />
                  <span class="input-unit-suffix text-xs right-6">m</span>
                </div>
              </div>

              <div>
                <label class="label-form-section mb-4" data-i18n="cadastre.lblTolerance"></label>
                <div class="input-unit-group">
                  <input type="number" id="rw5Tolerance" value="7.0" step="0.5" min="1" max="50"
                    class="form-input text-xs h-32 px-8 py-4" />
                  <span class="input-unit-suffix text-xs right-6">cm</span>
                </div>
              </div>

              <div>
                <label class="label-form-section mb-4" data-i18n="cadastre.lblMinTime"></label>
                <div class="input-unit-group">
                  <input type="number" id="rw5MinTime" value="60" step="5" min="0" max="1440"
                    class="form-input text-xs h-32 px-8 py-4" />
                  <span class="input-unit-suffix text-xs right-6">dk</span>
                </div>
              </div>

              <div>
                <button
                  class="btn btn-primary w-full h-32 text-xs font-bold d-inline-flex items-center justify-center gap-6"
                  id="btnAnalyzeRw5">
                  <i class="fa-solid fa-bolt"></i> <span data-i18n="cadastre.btnUploadSolve"></span>
                </button>
              </div>
            </div>

            <!-- TG-20 Optional Geoid Reduction Switch Bar -->
            <div class="cadastre-tg20-bar">
              <div class="d-flex items-center gap-10 flex-wrap">
                <label class="checkbox-tg20-label">
                  <input type="checkbox" id="chkRw5ApplyTg20" class="cursor-pointer accent-emerald" />
                  <span class="text-sm font-bold text-emerald d-flex items-center gap-6">
                    <i class="fa-solid fa-mountain-sun"></i> <span data-i18n="cadastre.lblTg20Reduction"></span>
                  </span>
                </label>
                <div id="badgeRw5Tg20Applied" class="d-none">
                  <span class="badge badge-emerald text-sm">
                    <i class="fa-solid fa-check-circle"></i> <span data-i18n="cadastre.badgeTg20Active"></span>
                  </span>
                </div>
                <span class="text-sm text-dim" id="lblRw5Tg20Status" data-i18n="cadastre.lblTg20StatusHint"></span>
              </div>
              <div>
                <button type="button" class="btn btn-primary btn-sm btn-tg20-pdf" id="btnPrintTg20RwReportTop">
                  <i class="fa-solid fa-file-pdf"></i> <span data-i18n="cadastre.btnPdfReport"></span>
                </button>
              </div>
            </div>
          </div>

          <!-- Static Coordinate Notice Banner (Shows when user uploads TXT/NCN instead of Raw GNSS sessions) -->
          <div id="cadastreStaticCoordBanner" class="alert-static-coord-banner d-none">
            <div class="d-flex items-start gap-12">
              <div class="alert-icon pt-2"><i class="fa-solid fa-circle-info text-amber text-lg"></i></div>
              <div class="flex-1">
                <div class="font-bold text-amber text-sm" data-i18n="cadastre.bannerStaticTitle"></div>
                <div class="text-xs text-dim mt-4 leading-relaxed" data-i18n="cadastre.bannerStaticDesc"></div>
                <div class="mt-8 d-flex gap-8 flex-wrap">
                  <button type="button" class="btn btn-secondary btn-xs" id="btnGoToFormatConverter">
                    <i class="fa-solid fa-file-export text-cyan"></i> <span data-i18n="cadastre.btnGoConverter"></span>
                  </button>
                  <button type="button" class="btn btn-secondary btn-xs" id="btnGoToCoordTransform">
                    <i class="fa-solid fa-arrows-rotate text-emerald"></i> <span data-i18n="cadastre.btnGoGeodesy"></span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- GPSFormat Subtabs Bar -->
          <div class="subtabs-bar">
            <button class="btn btn-primary sub-tab-btn active" data-subtab="subtab-rtk">
              <i class="fa-solid fa-satellite"></i> <span data-i18n="cadastre.tabRtkTable"></span>
            </button>
            <button class="btn btn-secondary sub-tab-btn d-inline-flex items-center gap-6" data-subtab="subtab-gcp"
              id="btnSubtabGcp">
              <i class="fa-solid fa-check-double"></i>
              <span data-i18n="cadastre.tabGcpKarne"></span>
              <span id="badgeGcpPairCount" class="d-none"></span>
            </button>
            <button class="btn btn-secondary sub-tab-btn" data-subtab="subtab-coordinate">
              <i class="fa-solid fa-file-lines"></i> <span data-i18n="cadastre.tabCoordsTransfer"></span>
            </button>
            <button class="btn btn-secondary sub-tab-btn" data-subtab="subtab-view">
              <i class="fa-solid fa-map-location-dot"></i> <span data-i18n="cadastre.tabMapView"></span>
            </button>
          </div>

          <!-- SUBTAB 1: RTK ÖLÇÜM TABLOSU (Unified RTK & Detail Master Table) -->
          <div id="subtab-rtk" class="subtab-content active">
            <div class="cadastre-table-panel">
              <div class="card-header items-center flex-wrap gap-8 border-b pb-8 mb-10">
                <div class="card-title m-0">
                  <i class="fa-solid fa-satellite text-cyan"></i>
                  <span data-i18n="cadastre.rtkTableTitle"></span>
                </div>
                <div class="d-flex flex-wrap gap-6 items-center">
                  <button class="btn btn-primary btn-sm btn-tg20-pdf" id="btnPrintTg20RwReportRtk"><i
                      class="fa-solid fa-file-pdf"></i> <span data-i18n="cadastre.btnPdfReportShort"></span></button>
                  <button class="btn btn-purple btn-sm text-sm" id="btnExportNcnRtk"><i
                      class="fa-solid fa-vector-square"></i> <span data-i18n="cadastre.btnNetcadNcn"></span></button>
                  <button class="btn btn-secondary btn-sm text-sm" id="btnExportRtkCsv"><i
                      class="fa-solid fa-file-csv"></i> <span data-i18n="cadastre.btnRtkCsv"></span></button>
                  <button class="btn btn-secondary btn-sm text-sm" id="btnExportDxfRtk"><i
                      class="fa-solid fa-draw-polygon"></i> <span data-i18n="cadastre.btnAutocadDxf"></span></button>
                  <button class="btn btn-secondary btn-sm text-sm" id="btnExportKmlRtk"><i
                      class="fa-solid fa-earth-americas"></i> 3D KML</button>
                </div>
              </div>

              <div class="table-responsive table-scroll-520">
                <table>
                  <thead id="theadGpsFormatRtk">
                    <tr>
                      <th>#</th>
                      <th>Point</th>
                      <th>Date/Time</th>
                      <th data-i18n="ui.eastingSaga"></th>
                      <th data-i18n="ui.northingYukari"></th>
                      <th id="thRtkKot">EL.Hgt. (h)</th>
                      <th class="th-tg20-n col-tg20" style="display:none"><i class="fa-solid fa-layer-group"></i> TG-20 (N)</th>
                      <th class="th-tg20-h col-tg20" style="display:none"><i class="fa-solid fa-mountain"></i> <span data-i18n="geomatics.orthometricHeight"></span></th>
                      <th>Ep.</th>
                      <th>Hz</th>
                      <th>SAT.</th>
                      <th>hRms (m)</th>
                      <th>vRms (m)</th>
                      <th>Pdop</th>
                      <th>Status</th>
                      <th>Network</th>
                      <th>Method</th>
                      <th>Ant.Ht.</th>
                      <th>Latitude (N)</th>
                      <th>Longitude (E)</th>
                    </tr>
                  </thead>
                  <tbody id="tableGpsFormatRtkBody"></tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- SUBTAB 2: GCP / ÇİFT OKUMA VE RESMİ ÖLÇÜ KARNESİ -->
          <div id="subtab-gcp" class="subtab-content">
            <div class="cadastre-table-panel">
              <div class="card-header items-center flex-wrap gap-8 border-b pb-8 mb-10">
                <div class="card-title m-0">
                  <i class="fa-solid fa-check-double text-emerald"></i>
                  <span data-i18n="cadastre.gcpMasterTitle"></span>
                </div>
                <div class="d-flex flex-wrap gap-6 items-center">
                  <button class="btn btn-primary btn-sm btn-tg20-pdf" id="btnPrintCadastre"><i
                      class="fa-solid fa-file-pdf"></i> <span data-i18n="cadastre.btnOfficialKarnePdf"></span></button>
                  <button class="btn btn-primary btn-sm btn-tg20-pdf" id="btnPrintTg20RwReportGcp"><i
                      class="fa-solid fa-file-pdf"></i> <span data-i18n="cadastre.btnPdfReportShort"></span></button>
                  <button class="btn btn-purple btn-sm text-sm" id="btnExportNcn"><i
                      class="fa-solid fa-vector-square"></i> <span data-i18n="cadastre.btnNetcadNcn"></span></button>
                  <button class="btn btn-secondary btn-sm text-sm" id="btnExportCadastreCsv"><i
                      class="fa-solid fa-file-excel"></i> Excel / CSV</button>
                  <button class="btn btn-secondary btn-sm text-sm" id="btnExportDxf"><i
                      class="fa-solid fa-draw-polygon"></i> <span data-i18n="cadastre.btnAutocadDxf"></span></button>
                  <button class="btn btn-secondary btn-sm text-sm" id="btnExportKmlCadastre"><i
                      class="fa-solid fa-earth-americas"></i> 3D KML</button>
                </div>
              </div>

              <!-- Warning Alert Balloon when No Double Readings Exist -->
              <div id="alertGcpNoPairs" class="alert-amber-banner">
                <div class="d-flex items-center gap-8">
                  <i class="fa-solid fa-circle-info text-amber text-md"></i>
                  <span class="text-sm text-dim" data-i18n="cadastre.alertNoPairsDesc"></span>
                </div>
                <span class="text-xs text-emerald badge badge-emerald font-semibold">
                  <i class="fa-solid fa-check"></i> <span data-i18n="cadastre.alertDownloadSingleTg20Pdf"></span>
                </span>
              </div>

              <div class="table-responsive table-scroll-520">
                <table>
                  <thead id="theadRw5Matched">
                    <tr>
                      <th data-i18n="ui.noktaAdi"></th>
                      <th data-i18n="ui.1OlcuZaman"></th>
                      <th data-i18n="ui.2OlcuZaman"></th>
                      <th data-i18n="ui.zamanFarki"></th>
                      <th>dY (cm)</th>
                      <th>dX (cm)</th>
                      <th>dH (cm)</th>
                      <th>dS (2B cm)</th>
                      <th data-i18n="ui.olcumHataKontrolu"></th>
                      <th data-i18n="ui.ySaga"></th>
                      <th data-i18n="ui.xYukari"></th>
                      <th id="thRw5MatchedKot" data-i18n="ui.hKot"></th>
                      <th class="th-tg20-n col-tg20" style="display:none"><i class="fa-solid fa-layer-group"></i> TG-20 (N)</th>
                      <th class="th-tg20-h col-tg20" style="display:none"><i class="fa-solid fa-mountain"></i> <span data-i18n="geomatics.orthometricHeight"></span></th>
                    </tr>
                  </thead>
                  <tbody id="tableRw5MatchedBody"></tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- ========================================================================= -->
          <!-- CADASTRE & RTK COMPONENT TEMPLATES (Zero-overhead clean DOM templates)    -->
          <!-- ========================================================================= -->
          <template id="tmplRtkRow">
            <tr class="cadastre-rtk-row cursor-pointer">
              <td class="cell-idx text-dim"></td>
              <td class="cell-pn font-bold text-cyan"></td>
              <td class="cell-time text-sm font-mono"></td>
              <td class="cell-e font-mono font-semibold"></td>
              <td class="cell-n font-mono font-semibold"></td>
              <td class="cell-h font-mono"></td>
              <td class="cell-tg20-n td-tg20-n col-tg20" style="display:none"></td>
              <td class="cell-tg20-h td-tg20-h col-tg20" style="display:none"></td>
              <td class="cell-ep"></td>
              <td class="cell-hz"></td>
              <td class="cell-sats"></td>
              <td class="cell-hrms font-mono text-emerald"></td>
              <td class="cell-vrms font-mono text-sky"></td>
              <td class="cell-pdop font-mono"></td>
              <td class="cell-status"></td>
              <td class="cell-network"></td>
              <td class="cell-method"></td>
              <td class="cell-hr font-mono"></td>
              <td class="cell-lat font-mono text-xs"></td>
              <td class="cell-lon font-mono text-xs"></td>
            </tr>
          </template>

          <template id="tmplMatchedRow">
            <tr class="cadastre-matched-row cursor-pointer">
              <td class="cell-pn font-bold text-white"></td>
              <td class="cell-t1 text-sm font-mono"></td>
              <td class="cell-t2 text-sm font-mono"></td>
              <td class="cell-dt"></td>
              <td class="cell-dy font-mono"></td>
              <td class="cell-dx font-mono"></td>
              <td class="cell-dh font-mono"></td>
              <td class="cell-ds font-mono font-extrabold text-sm"></td>
              <td class="cell-status"></td>
              <td class="cell-e font-mono text-cyan font-bold"></td>
              <td class="cell-n font-mono text-cyan font-bold"></td>
              <td class="cell-h font-mono"></td>
              <td class="cell-tg20-n td-tg20-n col-tg20" style="display:none"></td>
              <td class="cell-tg20-h td-tg20-h col-tg20" style="display:none"></td>
            </tr>
          </template>

          <template id="tmplUnmatchedRow">
            <tr class="cadastre-unmatched-row bg-amber/5 cursor-pointer">
              <td class="cell-pn font-bold text-white"></td>
              <td class="cell-t1 text-sm font-mono"></td>
              <td class="cell-t2 text-dim text-center">--</td>
              <td class="cell-dt text-dim text-center">--</td>
              <td class="cell-dy text-dim text-center">--</td>
              <td class="cell-dx text-dim text-center">--</td>
              <td class="cell-dh text-dim text-center">--</td>
              <td class="cell-ds text-dim text-center">--</td>
              <td class="cell-status"><span class="badge-single-warn">Tekil Ölçü (2. Okuma Yok)</span></td>
              <td class="cell-e font-mono text-amber"></td>
              <td class="cell-n font-mono text-amber"></td>
              <td class="cell-h font-mono"></td>
              <td class="cell-tg20-n td-tg20-n col-tg20" style="display:none"></td>
              <td class="cell-tg20-h td-tg20-h col-tg20" style="display:none"></td>
            </tr>
          </template>

          <!-- SUBTAB 3: COORDINATE -->
          <div id="subtab-coordinate" class="subtab-content">
            <div class="cadastre-table-panel">
              <div class="card-header flex-wrap gap-8 border-b pb-8 mb-10">
                <div class="card-title m-0"><i class="fa-solid fa-file-lines text-purple"></i><span data-i18n="cadastre.coordsExportTitle"></span></div>
                <div class="d-flex gap-8 items-center flex-wrap">
                  <label class="text-sm text-muted" data-i18n="ui.siralama"></label>
                  <select id="selectCoordOrder" class="form-input form-select text-sm h-32">
                    <option value="Pt,E,N,h" data-i18n="ui.noktanoSagaYYukari"></option>
                    <option value="Pt,N,E,h" data-i18n="ui.noktanoYukariXSaga"></option>
                    <option value="E,N,h,Pt" data-i18n="ui.sagaYYukariX"></option>
                    <option value="CSV_Y_X_H" data-i18n="ui.noktanoSagaYYukari"></option>
                  </select>
                  <button class="btn btn-primary" id="btnCopyCoords"><i class="fa-solid fa-copy"></i> <span data-i18n="common.copy"></span></button>
                  <button class="btn btn-secondary" id="btnDownloadCoordTxt"><i class="fa-solid fa-download"></i> <span data-i18n="cadastre.btnDownloadTxt"></span></button>
                </div>
              </div>
              <textarea id="txtCoordOutput" class="code-editor-textarea" readonly></textarea>
            </div>
          </div>

          <!-- SUBTAB 4: VIEW / HARİTA -->
          <div id="subtab-view" class="subtab-content">
            <div class="card cadastre-interactive-map-card p-0 overflow-hidden">
              <div class="card-header p-14 border-b border-white/10 d-flex items-center justify-between flex-wrap gap-8">
                <div class="card-title m-0">
                  <i class="fa-solid fa-map-location-dot text-cyan"></i>
                  <span id="titleCadastreMap" data-i18n="cadastre.mapTitle"></span>
                  <span class="badge badge-cyan text-xs font-mono ml-6" id="badgeCadastreMapCrs" data-i18n="cadastre.badgeCrsDefault"></span>
                  <span class="badge badge-secondary text-xs font-mono ml-4" id="badgeCadastreMapCount" data-i18n="ui.0Nokta"></span>
                </div>
                <div class="d-flex items-center gap-6 flex-wrap">
                  <button type="button" class="btn btn-xs btn-secondary" id="btnCadastreResetView" title="" data-i18n-title="cadastre.btnResetView">
                    <i class="fa-solid fa-earth-americas text-cyan"></i> <span data-i18n="cadastre.btnResetView"></span>
                  </button>
                  <button type="button" class="btn btn-xs btn-secondary" id="btnFitCadastreMap" title="" data-i18n-title="cadastre.btnFit">
                    <i class="fa-solid fa-expand"></i> <span data-i18n="cadastre.btnFit"></span>
                  </button>
                  <button type="button" class="btn btn-xs btn-secondary active text-cyan" id="btnCadastreToggleLabels" title="" data-i18n-title="cadastre.btnLabels">
                    <i class="fa-solid fa-tag"></i> <span data-i18n="cadastre.btnLabels"></span>
                  </button>
                  <button type="button" class="btn btn-xs btn-secondary" id="btnCadastreToggleRoute" title="" data-i18n-title="cadastre.btnRoute">
                    <i class="fa-solid fa-route"></i> <span data-i18n="cadastre.btnRoute"></span>
                  </button>
                  <div class="btn-group ml-4" id="cadastreMapFilterGroup">
                    <button type="button" class="btn btn-xs btn-secondary active" data-map-filter="ALL" id="filterCadastreAll" data-i18n="cadastre.filterAll"></button>
                    <button type="button" class="btn btn-xs btn-secondary text-emerald" data-map-filter="DUAL_PASS" id="filterCadastreDualPass" data-i18n="cadastre.filterDualPass"></button>
                    <button type="button" class="btn btn-xs btn-secondary text-rose" data-map-filter="DUAL_FAIL" id="filterCadastreDualFail" data-i18n="cadastre.filterDualFail"></button>
                    <button type="button" class="btn btn-xs btn-secondary text-amber" data-map-filter="SINGLE" id="filterCadastreSingle" data-i18n="cadastre.filterSingle"></button>
                  </div>
                </div>
              </div>

              <!-- Full Height Panoramic Map Canvas (560px) + Floating Telemetry HUD -->
              <div class="pos-rel w-100">
                <div id="cadastreMapContainer" class="cadastre-map-canvas"></div>

                <!-- Floating Luxury GIS Telemetry Panel (Corner Docked) -->
                <div id="cadastreMapLiveHud" class="cadastre-map-hud-badge">
                  <div class="d-flex items-center gap-10">
                    <div class="cadastre-hud-icon-box">
                      <i class="fa-solid fa-crosshairs text-cyan text-lg"></i>
                    </div>
                    <div class="d-flex flex-col">
                      <span class="text-2xs uppercase tracking-wider text-dim font-bold" id="lblCadastreHudTitle" data-i18n="cadastre.hudTelemetryTitle"></span>
                      <div class="d-flex items-baseline gap-6">
                        <span id="cadastreHudPointName" class="text-lg font-mono font-extrabold text-cyan text-glow-cyan">--</span>
                        <span id="cadastreHudStatusBadge" class="badge badge-secondary text-2xs" data-i18n="cadastre.hudNoSurvey"></span>
                        <span id="cadastreHudDsVal" class="text-xs font-mono text-emerald font-bold"></span>
                      </div>
                    </div>
                  </div>

                  <div class="cadastre-hud-divider"></div>

                  <div class="d-flex flex-col gap-2 text-xs">
                    <div class="d-flex items-center gap-8">
                      <span class="text-dim" data-i18n="ui.sagaYukari"></span>
                      <strong id="cadastreHudCoords" class="font-mono text-white">Y: -- | X: --</strong>
                    </div>
                    <div class="d-flex items-center gap-8">
                      <span class="text-dim" data-i18n="ui.kotHHN"></span>
                      <strong id="cadastreHudHeights" class="font-mono text-amber">H: -- | h: -- | N: --</strong>
                    </div>
                  </div>

                  <div class="cadastre-hud-divider d-none-mobile"></div>

                  <div class="d-flex flex-col gap-2 text-xs d-none-mobile">
                    <div class="d-flex items-center gap-8">
                      <span class="text-dim">Kalite / PDOP:</span>
                      <strong id="cadastreHudQuality" class="font-mono text-cyan">RMS: -- | PDOP: --</strong>
                    </div>
                    <div class="d-flex items-center gap-8">
                      <span class="text-dim">Uydu / Zaman:</span>
                      <strong id="cadastreHudTime" class="font-mono text-slate-300">SAT: -- | --:--:--</strong>
                    </div>
                  </div>

                  <div class="cadastre-hud-divider"></div>

                  <div class="d-flex items-center gap-6">
                    <button type="button" id="btnCadastreHudCopy"
                      class="btn btn-secondary btn-sm text-xs py-4 px-10 text-cyan border-cyan font-bold"
                      title="Nokta koordinatlarını kopyala">
                      <i class="fa-solid fa-copy"></i> <span data-i18n="cadastre.hudBtnCopy"></span>
                    </button>
                    <button type="button" id="btnCadastreHudFocus"
                      class="btn btn-primary btn-sm text-xs py-4 px-10 font-bold"
                      title="Noktaya Odaklan / Yaklaş">
                      <i class="fa-solid fa-magnifying-glass-location"></i> <span data-i18n="cadastre.hudBtnFocus"></span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Quick Export Toolbar -->
              <div class="card converter-export-card cadastre-map-export-card">
                <div class="d-flex justify-between items-center flex-wrap gap-8">
                  <div class="converter-export-tag">
                    <i class="fa-solid fa-file-export text-emerald"></i>
                    <span id="lblCadastreMapExport" data-i18n="cadastre.exportTitle"></span>
                  </div>

                  <div class="converter-export-btns" id="cadastreMapExportButtons">
                    <button type="button" class="btn-converter-export btn-soft-cyan" id="btnCadastreMapExportDxf" title="AutoCAD / Netcad DXF Olarak İndir">
                      <i class="fa-solid fa-file-code text-cyan"></i> <span data-i18n="cadastre.btnExportDxf"></span>
                    </button>
                    <button type="button" class="btn-converter-export" id="btnCadastreMapExportKml" title="Google Earth KML Olarak İndir">
                      <i class="fa-solid fa-earth-americas text-emerald"></i> <span data-i18n="cadastre.btnExportKml"></span>
                    </button>
                    <button type="button" class="btn-converter-export" id="btnCadastreMapExportNcn" title="Netcad Nokta Dosyası (.NCN) Olarak İndir">
                      <i class="fa-solid fa-hashtag text-cyan"></i> <span data-i18n="cadastre.btnExportNcn"></span>
                    </button>
                    <button type="button" class="btn-converter-export" id="btnCadastreMapExportCsv" title="Excel / CSV Formatında İndir">
                      <i class="fa-solid fa-file-csv text-emerald"></i> <span data-i18n="cadastre.btnExportCsv"></span>
                    </button>
                    <button type="button" class="btn-converter-export btn-soft-amber" id="btnCadastreMapExportPdf" title="BÖHHBÜY Madde 28 Çift Okuma PDF Karnesi">
                      <i class="fa-solid fa-file-pdf text-amber"></i> <span data-i18n="cadastre.btnExportPdf"></span>
                    </button>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Status Bar -->
          <div class="status-bar-footer">
            <div><span class="text-cyan font-bold">Kriter:</span> <span id="barCriterion">0.07m [FIX]</span></div>
            <div><span class="text-cyan font-bold">Projeksiyon:</span> <span id="barProj">ITRF-TM 3° 30° E</span></div>
            <div><span class="text-cyan font-bold">Jeoid:</span> <span id="barGeoid">N=h-H=34.455m</span></div>
            <div><span class="text-emerald font-semibold">Harita Tools Pro</span> | Web Edition</div>
          </div>

        </div>
      </section>

      <!-- ================= TAB 2: UNIFIED RINEX & GNSS WORKSTATION STUDIO ================= -->
      <section id="tab-rinex-studio" class="tool-tab">
        <div class="card d-flex flex-col gap-16">

          <!-- Master Card Header -->
          <div class="card-header flex-wrap gap-12 mb-0 pb-12">
            <div class="card-title">
              <i class="fa-solid fa-wand-magic-sparkles text-purple text-lg"></i>
              <span data-i18n="rinex.headerTitle"></span>
            </div>
            <div class="d-flex gap-6 flex-wrap">
              <span class="badge badge-cyan text-xs font-bold" data-i18n="rinex.badgeMultiStation"></span>
              <span class="badge badge-purple text-xs font-bold" data-i18n="rinex.badgeFreqPrune"></span>
              <span class="badge badge-emerald text-xs font-bold" data-i18n="rinex.badgeRinexVersions"></span>
            </div>
          </div>

          <!-- Bento Row 1: File Dropzone & Processing Configurations -->
          <div class="grid-2col-rinex">

            <!-- Dropzone Panel -->
            <div class="rinex-dropzone-panel">
              <div class="dropzone rinex-dropzone-inner" id="mergerDropzone">
                <div class="dropzone-icon-badge">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
                <h3 class="dropzone-title" data-i18n="rinex.dropzoneTitle"></h3>
                <p class="dropzone-desc" data-i18n="rinex.dropzoneDesc"></p>
                <div class="d-inline-flex">
                  <span class="btn btn-primary pointer-events-none py-8 px-18 text-sm font-bold">
                    <i class="fa-solid fa-folder-open"></i> <span data-i18n="rinex.btnSelectFiles"></span>
                  </span>
                </div>
                <input type="file" id="mergerFileInput" multiple />
              </div>
            </div>

            <!-- Processing & Filtering Parameter Tile -->
            <div class="rinex-config-panel d-flex flex-col gap-14">
              <div class="card-title mb-0">
                <i class="fa-solid fa-sliders text-purple"></i>
                <span data-i18n="rinex.settingsTitle"></span>
              </div>

              <!-- Pruning / Deletion Notice Badge -->
              <div class="alert-pruning-box">
                <i class="fa-solid fa-circle-info text-cyan text-md flex-shrink-0"></i>
                <span>Tüm tespit edilen sistemler varsayılan olarak seçilidir. <strong data-i18n="ui.iSaretiniTikiniKaldirdiginiz"></strong> uydular, frekanslar veya gözlem tipleri sonuç dosyasından ayıklanır.</span>
              </div>

              <!-- Constellation Selector Toggles -->
              <div>
                <label class="label-form-section">
                  1. Tespit Edilen Uydu Sistemleri <span class="text-dim font-normal text-xs" data-i18n="ui.secimiKaldirarakAyiklayabilirsiniz"></span>:
                </label>
                <div id="containerConstellations" class="d-flex gap-6 flex-wrap">
                  <span class="empty-scan-placeholder" data-i18n="ui.dosyaYuklendigindeIceriktekiUydu"></span>
                </div>
              </div>

              <!-- Frequency Bands & Carrier Selector -->
              <div>
                <label class="label-form-section">
                  2. Tespit Edilen Frekans & Taşıyıcı Bantları <span class="text-dim font-normal text-xs" data-i18n="ui.secimiKaldirarakAyiklayabilirsiniz"></span>:
                </label>
                <div id="containerBands" class="d-flex gap-6 flex-wrap">
                  <span class="empty-scan-placeholder" data-i18n="ui.dosyadaMevcutOlanFrekans"></span>
                </div>
              </div>

              <!-- Observable Types Selector -->
              <div>
                <label class="label-form-section">
                  3. Tespit Edilen Gözlem Tipleri <span class="text-dim font-normal text-xs" data-i18n="ui.secimiKaldirarakAyiklayabilirsiniz"></span>:
                </label>
                <div id="containerObsTypes" class="d-flex gap-6 flex-wrap">
                  <span class="empty-scan-placeholder">
                    📡 Faz, Kod, Doppler, SNR tipleri burada listelenecektir.
                  </span>
                </div>
              </div>

              <!-- Time Window & Slicing Control -->
              <div id="timeCropPanel" class="time-crop-panel">
                <div class="d-flex justify-between items-center">
                  <label class="label-form-section text-cyan d-flex items-center gap-6 m-0">
                    <i class="fa-solid fa-clock-rotate-left"></i> Zaman Aralığı & Kesme (Time Window Crop):
                  </label>
                  <div class="d-flex items-center gap-8">
                    <span id="lblTimeCropStatusText" class="text-sm font-semibold text-dim" data-i18n="rinex.filterDisabled"></span>
                    <label class="switch-glass" title="Zaman kesme filtresini aç/kapat">
                      <input type="checkbox" id="chkEnableTimeCrop" />
                      <span class="slider-glass"></span>
                    </label>
                  </div>
                </div>

                <!-- Inner Controls Container (Controlled by Switch) -->
                <div id="timeCropControlsContainer" class="time-crop-disabled d-flex flex-col gap-8">
                  <!-- Discovered Time Range Display -->
                  <div class="time-crop-meta-box">
                    <span>📅 <strong id="lblDetectedDate" class="text-pure">Tarih: --</strong></span>
                    <span>⏱️ Mevcut Oturum: <strong id="lblDetectedTimeRange" class="text-cyan font-mono">--:--:-- -
                        --:--:-- UTC</strong></span>
                    <span>⌛ Toplam Süre: <strong id="lblDetectedDuration" class="text-purple">--</strong></span>
                  </div>

                  <!-- Time Inputs & Presets -->
                  <div class="d-grid gap-8 items-end time-crop-presets-grid">
                    <div>
                      <span class="text-xs font-semibold text-dim d-block mb-2" data-i18n="rinex.lblCropStart"></span>
                      <input type="time" id="inputCropStart" step="1" value="00:00:00" class="time-input-glass" />
                    </div>
                    <div>
                      <span class="text-xs font-semibold text-dim d-block mb-2" data-i18n="rinex.lblCropEnd"></span>
                      <input type="time" id="inputCropEnd" step="1" value="23:59:59" class="time-input-glass" />
                    </div>
                    <div class="d-flex gap-4 flex-wrap">
                      <button type="button" class="btn btn-secondary text-sm"
                        onclick="applyCropPreset('ALL')" data-i18n="common.all"></button>
                      <button type="button" class="btn btn-secondary text-sm" onclick="applyCropPreset('FIRST_1H')" data-i18n="rinex.btnCrop1h"></button>
                      <button type="button" class="btn btn-secondary text-sm" onclick="applyCropPreset('FIRST_2H')" data-i18n="rinex.btnCropFirst2h"></button>
                      <button type="button" class="btn btn-secondary text-sm" onclick="applyCropPreset('LAST_2H')" data-i18n="rinex.btnCropLast2h"></button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Output Version, Dynamic Format & Sampling Grid -->
              <div class="d-grid gap-10 rinex-output-config-grid">
                <!-- 1. Version Selector -->
                <div>
                  <label class="label-form-section mb-4" data-i18n="rinex.lblTargetVersion"></label>
                  <select id="selectTargetVersion" class="select-glass">
                    <optgroup label="── Klasik RINEX 2 ──">
                      <option value="RINEX_211" selected>RINEX 2.11 (TUSAGA / LGO / TBC)</option>
                      <option value="RINEX_210">RINEX 2.10 (Klasik GPS / GLO)</option>
                    </optgroup>
                    <optgroup label="── Modern Multi-GNSS ──">
                      <option value="RINEX_302" data-i18n="ui.rinex302Multi"></option>
                      <option value="RINEX_304" data-i18n="ui.rinex304Igs"></option>
                      <option value="RINEX_300" data-i18n="ui.rinex300I"></option>
                      <option value="RINEX_303" data-i18n="ui.rinex303Qzss"></option>
                      <option value="RINEX_305">RINEX 3.05 (BDS-3 & Galileo HAS)</option>
                      <option value="RINEX_400" data-i18n="ui.rinex400Yeni"></option>
                    </optgroup>
                  </select>
                </div>

                <!-- 2. Dynamic Output Format -->
                <div>
                  <label class="label-form-section mb-4 text-cyan" data-i18n="rinex.lblTargetFormat"></label>
                  <select id="selectTargetFormat" class="select-glass">
                    <!-- Populated dynamically based on selected version -->
                  </select>
                </div>

                <!-- 3. Decimation Step -->
                <div>
                  <label class="label-form-section mb-4 text-dim" data-i18n="rinex.lblDecimationStep"></label>
                  <select id="selectDecimationStep" class="select-glass font-mono">
                    <option value="1" data-i18n="ui.1SaniyeTumu"></option>
                    <option value="5">5 Saniye</option>
                    <option value="10">10 Saniye</option>
                    <option value="15">15 Saniye</option>
                    <option value="30">30 Saniye (CORS)</option>
                  </select>
                </div>
              </div>

            </div>
          </div>

          <!-- Bento Row 2: Discovered Groups Table & Action Station -->
          <div class="rinex-sub-card d-none" id="mergerResultCard">
            <div class="d-flex justify-between items-center flex-wrap gap-8 border-b pb-8 mb-10">
              <div class="card-title m-0">
                <i class="fa-solid fa-circle-nodes text-cyan"></i>
                <span data-i18n="rinex.secGroupsTitle"></span>
              </div>
              <div>
                <button class="btn btn-purple btn-merge-all" id="btnMergeAll">
                  <i class="fa-solid fa-bolt-lightning"></i> <span data-i18n="rinex.btnMergeAllZip"></span>
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="tableGroups">
                <thead>
                  <tr>
                    <th data-i18n="rinex.thGroupId"></th>
                    <th data-i18n="rinex.thStation"></th>
                    <th data-i18n="rinex.thYear"></th>
                    <th data-i18n="rinex.thDoy"></th>
                    <th data-i18n="rinex.thObs"></th>
                    <th data-i18n="rinex.thGpsNav"></th>
                    <th data-i18n="rinex.thGloNav"></th>
                    <th data-i18n="rinex.thAction"></th>
                  </tr>
                </thead>
                <tbody id="tableGroupsBody"></tbody>
              </table>
            </div>
          </div>

          <!-- Bento Row 3: Base - Rover PPK Pre-Flight Coverage & Overlap Inspector -->
          <div class="rinex-sub-card">
            <div class="card-header items-center pb-10 mb-14 border-bottom-glass">
              <div class="card-title m-0">
                <i class="fa-solid fa-tower-broadcast text-emerald"></i>
                <span data-i18n="rinex.ppkTitle"></span>
              </div>
              <span class="badge badge-emerald" data-i18n="rinex.ppkBadge"></span>
            </div>

            <div class="d-grid gap-14 ppk-cards-grid">
              <!-- Base Station RINEX -->
              <div class="ppk-station-card">
                <label class="label-form-section text-cyan mb-6" data-i18n="rinex.lblBaseStation"></label>
                <div class="file-upload-glass ppk-upload-box">
                  <span id="txtPpkBaseFileName" class="text-sm text-main d-flex items-center justify-center gap-6">
                    <i class="fa-solid fa-folder-open text-cyan"></i> <span data-i18n="rinex.lblBaseSelectOrDrag"></span>
                  </span>
                  <input type="file" id="inputPpkBaseFile" accept=".o,.rnx,.obs,.*o,.*O,.crx,.zip,.gz" />
                </div>
              </div>

              <!-- Rover Station RINEX -->
              <div class="ppk-station-card">
                <label class="label-form-section text-emerald mb-6" data-i18n="rinex.lblRoverStation"></label>
                <div class="file-upload-glass ppk-upload-box">
                  <span id="txtPpkRoverFileName" class="text-sm text-main d-flex items-center justify-center gap-6">
                    <i class="fa-solid fa-folder-open text-emerald"></i> <span data-i18n="rinex.lblRoverSelectOrDrag"></span>
                  </span>
                  <input type="file" id="inputPpkRoverFile" accept=".o,.rnx,.obs,.*o,.*O,.crx,.zip,.gz" />
                </div>
              </div>
            </div>

            <!-- PPK Analysis Dashboard -->
            <div id="ppkAnalysisResultWrapper" class="mt-14 d-none flex-col gap-12">
              <!-- Overall Status Banner -->
              <div id="bannerPpkStatus"
                class="p-16 rounded-sm border d-flex items-center justify-between flex-wrap gap-10">
                <div class="d-flex items-center gap-10">
                  <i id="iconPpkStatus" class="fa-solid fa-circle-check text-xl"></i>
                  <div>
                    <strong id="titlePpkStatus" class="text-md d-block" data-i18n="rinex.titlePpkSuccess"></strong>
                    <span id="descPpkStatus" class="text-sm text-dim" data-i18n="rinex.descPpkSuccess"></span>
                  </div>
                </div>
                <span id="badgePpkOverlapPercent" class="badge text-sm px-12 py-4 font-extrabold" data-i18n="ui.100Kapsama"></span>
              </div>

              <!-- Stats Grid -->
              <div class="d-grid gap-10 text-sm ppk-stats-grid">
                <div class="stat-card-glass">
                  <span class="text-dim d-block text-xs" data-i18n="rinex.lblBaseSessionUtc"></span>
                  <strong id="statPpkBaseTime" class="font-mono text-cyan text-sm">--:-- - --:--</strong>
                </div>
                <div class="stat-card-glass">
                  <span class="text-dim d-block text-xs" data-i18n="rinex.lblRoverSessionUtc"></span>
                  <strong id="statPpkRoverTime" class="font-mono text-emerald text-sm">--:-- - --:--</strong>
                </div>
                <div class="stat-card-glass">
                  <span class="text-dim d-block text-xs" data-i18n="rinex.lblOverlapDuration"></span>
                  <strong id="statPpkOverlapDuration" class="font-mono text-amber text-sm">-- sa -- dk</strong>
                </div>
                <div class="stat-card-glass">
                  <span class="text-dim d-block text-xs" data-i18n="rinex.lblApproxBaseline"></span>
                  <strong id="statPpkBaselineDist" class="font-mono text-purple text-sm">-- km</strong>
                </div>
                <div class="stat-card-glass">
                  <span class="text-dim d-block text-xs" data-i18n="rinex.lblCommonSystems"></span>
                  <strong id="statPpkCommonSystems" class="font-mono text-white text-sm">GPS + GLO</strong>
                </div>
              </div>

              <!-- Visual Timeline Bar -->
              <div class="stat-card-glass p-12">
                <span class="text-xs font-bold text-dim d-block mb-8" data-i18n="rinex.lblVisualTimeline"></span>
                <div class="d-flex flex-col gap-8">
                  <!-- Base Timeline -->
                  <div class="d-flex items-center gap-8">
                    <span class="text-xs text-cyan font-bold w-60" data-i18n="rinex.lblBaseShort"></span>
                    <div class="timeline-track-base">
                      <div id="barPpkBase" class="h-full bg-cyan rounded-2 w-full"></div>
                    </div>
                  </div>
                  <!-- Rover Timeline -->
                  <div class="d-flex items-center gap-8">
                    <span class="text-xs text-emerald font-bold w-60" data-i18n="rinex.lblRoverShort"></span>
                    <div class="timeline-track-rover">
                      <div id="barPpkRover" class="h-full bg-emerald rounded-2 pos-abs left-0 w-full"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bento Row 4: RINEX Quality, Multi-Constellation Timeline & Satellites Chart -->
          <div class="rinex-sub-card">
            <div class="card-header items-center pb-10 mb-14 border-bottom-glass">
              <div class="card-title m-0">
                <i class="fa-solid fa-chart-line text-amber"></i>
                <span data-i18n="rinex.qualityTitle"></span>
              </div>
              <span class="badge badge-amber" data-i18n="rinex.qualityBadge"></span>
            </div>

            <div class="quality-inspector-panel">
              <!-- File Selector for Quality Inspector -->
              <div class="d-flex items-center justify-between flex-wrap gap-10">
                <div class="text-sm text-dim" data-i18n="rinex.qualityPrompt"></div>
                <label
                  class="btn btn-primary btn-sm m-0 cursor-pointer d-inline-flex items-center gap-6 text-sm py-6 px-12">
                  <i class="fa-solid fa-satellite"></i> <span data-i18n="rinex.btnQualityAnalyze"></span>
                  <input type="file" id="inputRinexQualityFile" accept=".o,.rnx,.obs,.*o,.*O,.crx" class="d-none" />
                </label>
              </div>

              <!-- Quality Analysis Dashboard Results (Hidden initially) -->
              <div id="rinexQualityDashboard" class="d-none flex-col gap-12">
                <!-- Stat Cards Bar -->
                <div class="rinex-quality-stats-grid">
                  <div class="stat-card-glass">
                    <span class="quality-stat-label" data-i18n="rinex.statTotalEpochs"></span>
                    <strong id="statQualityEpochs" class="quality-stat-val text-cyan">0 Epoch</strong>
                  </div>
                  <div class="stat-card-glass">
                    <span class="quality-stat-label" data-i18n="rinex.statSamplingInterval"></span>
                    <strong id="statQualityInterval" class="quality-stat-val text-pure">1 sn</strong>
                  </div>
                  <div class="stat-card-glass">
                    <span class="quality-stat-label" data-i18n="rinex.statAvgMaxSat"></span>
                    <strong id="statQualitySatCount" class="quality-stat-val text-amber">-- / --</strong>
                  </div>
                  <div class="stat-card-glass">
                    <span class="quality-stat-label">GPS / GLO / GAL / BDS:</span>
                    <strong id="statQualityConstellation" class="quality-stat-val-sm text-emerald">-- / -- / -- / --</strong>
                  </div>
                  <div class="stat-card-glass">
                    <span class="quality-stat-label" data-i18n="rinex.statScore"></span>
                    <strong id="statQualityScore" class="quality-stat-val text-sky" data-i18n="ui.95Mukemmel"></strong>
                  </div>
                </div>

                <!-- Interactive Multi-Constellation Timeline Chart Canvas -->
                <div class="timeline-chart-box timeline-chart-container">
                  <!-- Legend -->
                  <div class="timeline-header-flex">
                    <span class="timeline-legend-title" data-i18n="rinex.timelineChartTitle"></span>
                    <div class="timeline-legend-items">
                      <span class="legend-item text-amber"><i class="fa-solid fa-circle legend-dot-8px"></i> Toplam</span>
                      <span class="legend-item text-sky"><i class="fa-solid fa-circle legend-dot-8px"></i> GPS</span>
                      <span class="legend-item text-rose"><i class="fa-solid fa-circle legend-dot-8px"></i> GLONASS</span>
                      <span class="legend-item text-purple"><i class="fa-solid fa-circle legend-dot-8px"></i> Galileo</span>
                      <span class="legend-item text-emerald"><i class="fa-solid fa-circle legend-dot-8px"></i> BeiDou</span>
                    </div>
                  </div>
                  <canvas id="canvasRinexQualityChart" width="900" height="180" class="quality-chart-canvas"></canvas>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ================= TAB 3: MAP VISUALIZER & PAFTA INDEX WORKSTATION ================= -->
      <section id="tab-map" class="tool-tab">
        <div class="card d-flex flex-col gap-14">
          <div class="card-header flex-wrap gap-12 mb-0">
            <div class="card-title">
              <i class="fa-solid fa-map-location-dot text-cyan"></i>
              <span data-i18n="map.headerTitle"></span>
            </div>
            <div class="d-flex gap-8 flex-wrap items-center">
              <label class="btn btn-primary m-0 cursor-pointer d-inline-flex items-center gap-6 py-8 px-14 text-sm">
                <i class="fa-solid fa-cloud-arrow-up"></i> <span data-i18n="map.btnImportKml"></span>
                <input type="file" id="inputImportKml" accept=".kml,.kmz,.geojson,.json" class="d-none" />
              </label>
            </div>
          </div>

          <!-- Pafta Index Control Toolbar -->
          <div class="pafta-toolbar">
            <div class="d-flex items-center gap-10 flex-wrap">
              <div class="d-flex items-center gap-8">
                <div class="pafta-toolbar-icon-badge">
                  <i class="fa-solid fa-layer-group"></i>
                </div>
                <span class="pafta-toolbar-title" data-i18n="map.toolbarTitle"></span>
              </div>
              <div class="d-flex items-center gap-6 flex-wrap">
                <button class="btn btn-sm" id="btnPafta100k">
                  <i class="fa-solid fa-border-all"></i> <span data-i18n="map.btnPafta100k"></span>
                </button>
                <button class="btn btn-sm" id="btnPafta50k">
                  <i class="fa-solid fa-table-cells-large"></i> <span data-i18n="map.btnPafta50k"></span>
                </button>
                <button class="btn btn-sm" id="btnPafta25k">
                  <i class="fa-solid fa-table-cells"></i> <span data-i18n="map.btnPafta25k"></span>
                </button>
                <button class="btn btn-sm" id="btnPafta5k">
                  <i class="fa-solid fa-border-none"></i> <span>1/5 000</span>
                </button>
                <button class="btn btn-sm" id="btnPafta2k">
                  <i class="fa-solid fa-border-all"></i> <span>1/2 000</span>
                </button>
                <button class="btn btn-sm" id="btnPafta1k">
                  <i class="fa-solid fa-microchip"></i> <span>1/1 000</span>
                </button>
                <button class="btn btn-sm" id="btnPaftaOff">
                  <i class="fa-solid fa-eye-slash"></i> <span data-i18n="map.btnPaftaOff"></span>
                </button>
                <div class="divider-v-glass"></div>
                <button class="btn btn-sm" id="btnToggleDom">
                  <i class="fa-solid fa-globe"></i> <span data-i18n="map.btnToggleDom"></span>
                </button>
              </div>
            </div>

            <!-- Search by Sheet Name -->
            <div class="pafta-search-wrapper">
              <div class="pafta-search-input-box">
                <i class="fa-solid fa-magnifying-glass pafta-search-icon"></i>
                <input type="text" id="inputPaftaSearch" placeholder="Pafta Ara (F22, H29-b, J28-b4, N21-d-13-b-2-a)..."
                  class="pafta-search-input">
              </div>
              <button class="btn btn-primary btn-sm pafta-search-btn" id="btnPaftaSearch" type="button">
                <i class="fa-solid fa-location-crosshairs"></i>
                <span data-i18n="common.goToPafta"></span>
              </button>
            </div>
          </div>

          <!-- Map Container with Floating Pafta Details Card & Intersecting Project Card -->
          <div class="pos-rel">
            <div id="mapContainer" class="cadastre-map-canvas overflow-hidden">
            </div>

            <!-- Floating Active Pafta Info Card (Bottom-Left) -->
            <div id="cardActivePafta" class="floating-pafta-card" style="display: none;">
              <div class="pafta-card-header">
                <div class="d-flex items-center gap-6">
                  <i class="fa-solid fa-map text-cyan"></i>
                  <span id="txtPaftaCardTitle" class="pafta-card-title" data-i18n="ui.f22Paftasi"></span>
                </div>
                <button id="btnClosePaftaCard" class="btn-close-minimal" type="button" title="Kapat">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>

              <div class="pafta-card-body">
                <div class="d-flex justify-between"><span class="text-dim" data-i18n="common.scale"></span> <strong id="txtPaftaCardScale" class="text-emerald" data-i18n="map.btnPafta100k"></strong></div>
                <div class="d-flex justify-between"><span class="text-dim" data-i18n="common.centerLat"></span> <span id="txtPaftaCardLat" class="font-mono">40.75000° N</span></div>
                <div class="d-flex justify-between"><span class="text-dim" data-i18n="common.centerLon"></span> <span id="txtPaftaCardLon" class="font-mono">28.75000° E</span></div>
                <div class="d-flex justify-between"><span class="text-dim">TUREF TM3° DOM:</span> <span id="txtPaftaCardDom" class="font-mono text-purple">DOM 27° (Dilim 9)</span></div>
                <div class="divider-glass"></div>
                <div class="d-flex justify-between"><span class="text-dim">1/100 000:</span> <span id="txtPaftaCard100k" class="font-mono font-extrabold text-cyan cursor-pointer">F22</span></div>
                <div class="d-flex justify-between"><span class="text-dim">1/50 000:</span> <span id="txtPaftaCard50k" class="font-mono font-extrabold text-purple cursor-pointer">F22-a</span></div>
                <div class="d-flex justify-between"><span class="text-dim">1/25 000:</span> <span id="txtPaftaCard25k" class="font-mono font-extrabold text-emerald cursor-pointer">F22-a1</span></div>
                <div class="d-flex justify-between"><span class="text-dim">1/5 000:</span> <span id="txtPaftaCard5k" class="font-mono font-extrabold text-rose cursor-pointer">--</span></div>
                <div class="d-flex justify-between"><span class="text-dim">1/2 000:</span> <span id="txtPaftaCard2k" class="font-mono font-extrabold text-indigo cursor-pointer">--</span></div>
                <div class="d-flex justify-between"><span class="text-dim">1/1 000:</span> <span id="txtPaftaCard1k" class="font-mono font-extrabold text-sky cursor-pointer">--</span></div>

