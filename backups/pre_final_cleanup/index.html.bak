                  KML</button>
                <button class="btn btn-secondary btn-sm pafta-btn-download-item" id="btnDownloadPaftaDxf"><i class="fa-solid fa-vector-square"></i> DXF</button>
                <button class="btn btn-secondary btn-sm pafta-btn-download-item" id="btnDownloadPaftaJson"><i class="fa-solid fa-code"></i> JSON</button>
              </div>
            </div>

            <!-- Floating Intersecting Paftas Info Card (Top-Right of Map) -->
            <div id="cardIntersectingPaftas" class="floating-intersect-card" style="display: none;">
              <div class="pafta-intersect-header">
                <div class="pafta-intersect-title-group">
                  <i class="fa-solid fa-layer-group pafta-intersect-icon"></i>
                  <span class="font-bold text-main pafta-intersect-title">Temas Eden Paftalar</span>
                  <span id="badgeIntersectingCount" class="badge-intersecting">0 Pafta</span>
                </div>
                <button id="btnCloseIntersectingCard" class="btn-close-minimal" type="button" title="Kapat">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>

              <!-- Project File Summary -->
              <div class="pafta-project-summary pafta-project-summary-box">
                <span class="pafta-summary-filename" id="txtImportedFileName" data-i18n="ui.projeDosyasi"></span>
                <span id="txtImportedFeatureCount" class="text-cyan font-bold">1 Geometri</span>
              </div>

              <!-- Scale Switcher for Intersecting Results -->
              <div class="pafta-scale-btn-row">
                <button class="btn btn-primary btn-sm btn-intersect-scale btn-pafta-scale-opt" data-scale="25k" data-i18n="map.btnPafta25k"></button>
                <button class="btn btn-secondary btn-sm btn-intersect-scale btn-pafta-scale-opt" data-scale="50k" data-i18n="map.btnPafta50k"></button>
                <button class="btn btn-secondary btn-sm btn-intersect-scale btn-pafta-scale-opt" data-scale="100k" data-i18n="map.btnPafta100k"></button>
              </div>

              <!-- List of Intersecting Paftas -->
              <div id="listIntersectingPaftas" class="pafta-intersect-scroll-list">
                <!-- Dynamically generated sheet items -->
              </div>

              <!-- Bulk KML Export for Intersecting Sheets -->
              <button id="btnDownloadAllIntersectingKml" class="btn btn-secondary btn-sm btn-download-all-kml">
                <i class="fa-solid fa-file-arrow-down text-emerald"></i>
                <span class="font-bold" data-i18n="ui.temasEdenTumPaftalari"></span>
              </button>
            </div>
          </div>
